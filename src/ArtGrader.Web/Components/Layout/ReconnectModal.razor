<script type="module" src="@Assets["Components/Layout/ReconnectModal.razor.js"]"></script>

<dialog id="components-reconnect-modal" data-nosnippet aria-labelledby="reconnect-title">
    <div class="reconnect-card">
        <svg class="reconnect-art" viewBox="0 0 240 110" aria-hidden="true">
            <path class="cable" d="M4 70 C 40 70, 50 40, 86 46" />
            <g class="plug">
                <rect x="84" y="30" width="38" height="32" rx="6" />
                <path d="M122 38 h14 M122 54 h14" />
            </g>
            <g class="spark">
                <path d="M146 28 l6 10 M158 22 v12 M170 28 l-6 10" />
            </g>
            <g class="socket">
                <rect x="160" y="30" width="38" height="32" rx="6" />
                <circle cx="172" cy="46" r="3.5" />
                <circle cx="186" cy="46" r="3.5" />
            </g>
            <path class="cable" d="M198 46 C 214 46, 220 76, 238 76" />
        </svg>

        <div class="components-reconnect-first-attempt-visible">
            <h2 id="reconnect-title">@T("One moment …")</h2>
            <p>@T("The connection to ArtGrader was briefly interrupted. It is being restored.")</p>
        </div>
        <div class="components-reconnect-repeated-attempt-visible">
            <h2>@T("No connection yet")</h2>
            <p>@((MarkupString)T("Trying again in {0} seconds.", "<span id=\"components-seconds-to-next-attempt\"></span>"))</p>
        </div>
        <div class="components-reconnect-failed-visible">
            <h2>@T("ArtGrader is not responding")</h2>
            <p>@T("ArtGrader may have been closed. Start ArtGrader and then try again. Your work is saved.")</p>
        </div>
        <div class="components-pause-visible">
            <h2>@T("Paused")</h2>
            <p>@T("The session is paused. Click ‘Resume’ to carry on where you left off.")</p>
        </div>
        <div class="components-resume-failed-visible">
            <h2>@T("Please reload")</h2>
            <p>@T("The session could not be resumed. Reload the page and everything will be back.")</p>
        </div>

        <div class="reconnect-actions">
            <button id="components-reconnect-button" class="components-reconnect-failed-visible reconnect-primary">@T("Try again")</button>
            <button id="components-resume-button" class="components-pause-visible reconnect-primary">@T("Resume")</button>
            <button type="button" class="components-reconnect-failed-visible components-resume-failed-visible reconnect-secondary" onclick="location.reload()">@T("Reload page")</button>
        </div>
    </div>
</dialog>
