@inherits LayoutComponentBase
@using ArtGrader.Core.Ai
@inject SettingsStore Settings
@inject CurrentExam Current
@inject GradingQueue Queue
@inject IDialogService Dialogs
@inject IJSRuntime JS
@implements IDisposable

<MudThemeProvider Theme="Themes.MudThemeFor(Settings.Theme)" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<header class="topbar">
    <div class="topbar-inner">
        <a href="/" class="brand" aria-label="@T("ArtGrader – to the overview")">
            <img src="@Assets["favicon.svg"]" alt="" />
            <span>
                <span class="brand-name">Art<em>Grader</em></span>
                <span class="brand-sub">@T("Visual Arts")</span>
            </span>
        </a>
        <span class="topbar-spacer"></span>
        <a href="/einstellungen" class="@($"provider-pill {(Ready ? "" : "warn")} {(LocalOnly ? "local-only" : "")}")" title="@(LocalOnly ? T("This assignment is assessed locally only") : T("Settings"))">
            <span class="dot"></span>
            <span class="label">@ProviderLabel()</span>
            <MudIcon Icon="@Icons.Material.Outlined.Tune" Size="Size.Small" />
        </a>
        <MudTooltip Text="@T("Quit ArtGrader")">
            <MudIconButton Icon="@Icons.Material.Outlined.PowerSettingsNew" Class="quit-button" OnClick="QuitAsync" aria-label="@T("Quit ArtGrader")" />
        </MudTooltip>
    </div>
</header>

<main class="page">
    <UpdateBanner />
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    @T("An unexpected error has occurred.")
    <a href="." class="reload">@T("Reload")</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private async Task QuitAsync()
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            T("Quit ArtGrader?"),
            Queue.IsBusy
                ? T("Works are still being assessed. This will be stopped, and you can assess them again after the next start.")
                : T("Everything is saved. To keep working, start ArtGrader again."),
            yesText: T("Quit"),
            cancelText: T("Cancel"));
        if (confirmed != true)
        {
            return;
        }
        try
        {
            await JS.InvokeVoidAsync("artGrader.quit");
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException)
        {
        }
    }

    private bool LocalOnly => Current.Value?.LocalOnly == true;

    private bool Ready => Current.Value is { } exam ? Settings.CanGrade(exam) : Settings.IsConfigured;

    private string ProviderLabel()
    {
        if (LocalOnly)
        {
            return string.IsNullOrWhiteSpace(Settings.OllamaModel) ? T("Local only · model missing") : T("Local only · {0}", Settings.OllamaModel);
        }
        if (!Settings.IsConfigured)
        {
            return Settings.Provider == AiProvider.Ollama ? T("Choose a local model") : T("API key missing");
        }
        return Settings.Provider == AiProvider.Ollama ? T("Local · {0}", Settings.OllamaModel) : "Claude · Cloud";
    }

    protected override void OnInitialized()
    {
        Settings.Changed += OnSettingsChanged;
        Current.Changed += OnSettingsChanged;
    }

    private void OnSettingsChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Settings.Changed -= OnSettingsChanged;
        Current.Changed -= OnSettingsChanged;
    }
}
