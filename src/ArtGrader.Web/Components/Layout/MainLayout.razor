@inherits LayoutComponentBase
@using ArtGrader.Core.Ai
@inject SettingsStore Settings
@inject CurrentExam Current
@inject GradingQueue Queue
@inject IDialogService Dialogs
@inject IJSRuntime JS
@implements IDisposable

<MudThemeProvider Theme="theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<header class="topbar">
    <div class="topbar-inner">
        <a href="/" class="brand" aria-label="ArtGrader – zur Übersicht">
            <img src="favicon.svg" alt="" />
            <span>
                <span class="brand-name">Art<em>Grader</em></span>
                <span class="brand-sub">Bildnerisches Gestalten</span>
            </span>
        </a>
        <span class="topbar-spacer"></span>
        <a href="/einstellungen" class="@($"provider-pill {(Ready ? "" : "warn")} {(LocalOnly ? "local-only" : "")}")" title="@(LocalOnly ? "Diese Prüfung wird nur lokal bewertet" : "Einstellungen")">
            <span class="dot"></span>
            <span class="label">@ProviderLabel()</span>
            <MudIcon Icon="@Icons.Material.Outlined.Tune" Size="Size.Small" />
        </a>
        <MudTooltip Text="ArtGrader beenden">
            <MudIconButton Icon="@Icons.Material.Outlined.PowerSettingsNew" Class="quit-button" OnClick="QuitAsync" aria-label="ArtGrader beenden" />
        </MudTooltip>
    </div>
</header>

<main class="page">
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    Ein unerwarteter Fehler ist aufgetreten.
    <a href="." class="reload">Neu laden</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private static readonly string[] Sans = ["DM Sans", "Segoe UI", "-apple-system", "BlinkMacSystemFont", "Helvetica Neue", "Arial", "sans-serif"];

    private readonly MudTheme theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#1f4fe0",
            Secondary = "#ec3b2c",
            Tertiary = "#ffc31f",
            Success = "#0f9a63",
            Warning = "#c98a00",
            Error = "#d42a1c",
            Info = "#1f4fe0",
            Background = "#ffffff",
            Surface = "#ffffff",
            TextPrimary = "#141414",
            TextSecondary = "#55534f",
            LinesInputs = "#c4c1b9",
            Divider = "#e4e2dc",
            ActionDefault = "#55534f",
        },
        Typography = new Typography
        {
            Default = new DefaultTypography { FontFamily = Sans },
            H4 = new H4Typography { FontFamily = Sans, FontWeight = "800" },
            H5 = new H5Typography { FontFamily = Sans, FontWeight = "800" },
            H6 = new H6Typography { FontFamily = Sans, FontWeight = "800" },
            Button = new ButtonTypography { FontFamily = Sans, FontWeight = "600", TextTransform = "none" },
        },
        LayoutProperties = new LayoutProperties { DefaultBorderRadius = "10px" },
    };

    private async Task QuitAsync()
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            "ArtGrader beenden?",
            Queue.IsBusy
                ? "Es werden noch Arbeiten bewertet. Sie werden abgebrochen und lassen sich nach dem nächsten Start neu bewerten."
                : "Alles ist gespeichert. Zum Weiterarbeiten ArtGrader wieder starten.",
            yesText: "Beenden",
            cancelText: "Abbrechen");
        if (confirmed != true)
        {
            return;
        }
        try
        {
            await JS.InvokeVoidAsync("artGrader.quit");
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException)
        {
        }
    }

    private bool LocalOnly => Current.Value?.LocalOnly == true;

    private bool Ready => Current.Value is { } exam ? Settings.CanGrade(exam) : Settings.IsConfigured;

    private string ProviderLabel()
    {
        if (LocalOnly)
        {
            return string.IsNullOrWhiteSpace(Settings.OllamaModel) ? "Nur lokal · Modell fehlt" : $"Nur lokal · {Settings.OllamaModel}";
        }
        if (!Settings.IsConfigured)
        {
            return Settings.Provider == AiProvider.Ollama ? "Lokales Modell wählen" : "API-Schlüssel fehlt";
        }
        return Settings.Provider == AiProvider.Ollama ? $"Lokal · {Settings.OllamaModel}" : "Claude · Cloud";
    }

    protected override void OnInitialized()
    {
        Settings.Changed += OnSettingsChanged;
        Current.Changed += OnSettingsChanged;
    }

    private void OnSettingsChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Settings.Changed -= OnSettingsChanged;
        Current.Changed -= OnSettingsChanged;
    }
}
