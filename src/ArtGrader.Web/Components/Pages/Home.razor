@page "/"
@inject ExamRepository Repository
@inject NavigationManager Navigation
@inject SettingsStore Settings
@inject FileStore Files
@inject IDialogService Dialogs

<PageTitle>@T("Prüfungen") · ArtGrader</PageTitle>

<div class="page-head">
    <div class="eyebrow">@Greeting()</div>
    <h1 class="page-title">@((MarkupString)T("Deine <em>Prüfungen</em>"))</h1>
    <p class="lede">
        @T("Aufgabe und Beurteilungsbogen hochladen, Fotos der Arbeiten dazulegen – die KI macht einen Vorschlag, du entscheidest.")
    </p>
</div>

@if (!Settings.IsConfigured)
{
    <div class="banner mb-6">
        <MudIcon Icon="@Icons.Material.Outlined.Lightbulb" />
        <span>@((MarkupString)T("Bevor die KI mitlesen kann, wähle unter {0} Claude oder ein lokales Modell.", SettingsLink))</span>
    </div>
}

@if (pastSemesters.Count > 0)
{
    var photos = pastSemesters.Sum(e => e.PhotoCount);
    var pastTitles = string.Join(", ", pastSemesters.Select(e => e.Title));
    var photoText = photos == 1 ? T("1 Foto") : T("{0} Fotos", photos);
    <div class="banner year-end mb-6">
        <MudIcon Icon="@Icons.Material.Outlined.EventAvailable" />
        <div class="year-end-text">
            <b>@T("Semester vorbei – Fotos löschen?")</b>
            <span>
                @(pastSemesters.Count == 1
                    ? T("1 Prüfung aus früheren Semestern ({0}) hat noch {1} von Schülerarbeiten.", pastTitles, photoText)
                    : T("{0} Prüfungen aus früheren Semestern ({1}) haben noch {2} von Schülerarbeiten.", pastSemesters.Count, pastTitles, photoText))
                @T("Schülerarbeiten gehören den Schülerinnen und Schülern und werden nach dem Semester gelöscht.")
                @T("Noten und Beurteilungen bleiben erhalten.")
            </span>
        </div>
        <MudButton Class="btn-ink" StartIcon="@Icons.Material.Outlined.DeleteSweep" OnClick="DeletePastPhotosAsync">@T("Fotos löschen")</MudButton>
    </div>
}

<div class="home-flow">
    <section>
        @if (exams is null)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Tertiary" />
        }
        else if (exams.Count == 0)
        {
            <div class="sheet empty-state">
                <img src="img/empty-sketch.svg" alt="" />
                <h2 class="sheet-title mt-3">@T("Noch ein leeres Skizzenbuch")</h2>
                <p class="muted">@T("Lege unten deine erste Prüfung an.")</p>
            </div>
        }
        else
        {
            <div class="exam-grid">
                @foreach (var exam in exams)
                {
                    var share = exam.SubmissionCount == 0 ? 0 : 100.0 * exam.CompletedCount / exam.SubmissionCount;
                    <a class="exam-card" href="@($"/pruefung/{exam.Id}")">
                        <div class="exam-cover">
                            @if (exam.Covers.Count == 0)
                            {
                                <div class="empty-cover"><img src="img/empty-sketch.svg" alt="" style="position:static;width:120px;height:auto;border:none;box-shadow:none;transform:none" /></div>
                            }
                            else
                            {
                                @foreach (var cover in exam.Covers)
                                {
                                    <img src="@($"/files/{cover}")" alt="" loading="lazy" />
                                }
                            }
                        </div>
                        <div class="exam-body">
                            <h3 class="exam-title">@exam.Title</h3>
                            <div class="exam-meta">
                                @(string.IsNullOrWhiteSpace(exam.SchoolClass) ? "" : T("Klasse {0} · ", exam.SchoolClass))@exam.Date.ToString(T("d. MMMM yyyy"), culture)
                            </div>
                            <div class="progress-line"><span style="@($"width:{share.ToString("0", System.Globalization.CultureInfo.InvariantCulture)}%")"></span></div>
                            <div class="progress-label">
                                <span>@T("{0} Arbeiten", exam.SubmissionCount)</span>
                                <span>@T("{0} abgeschlossen", exam.CompletedCount)</span>
                            </div>
                        </div>
                    </a>
                }
            </div>
        }
    </section>
    <section class="sheet new-exam">
        <h2 class="sheet-title">@T("Neue Prüfung")</h2>
        <p class="sheet-sub">@T("Ein neues Blatt anlegen.")</p>
        <MudStack Spacing="3">
            <MudTextField @bind-Value="title" Label="@T("Titel")" Placeholder="@T("z. B. Stadt von oben")" Variant="Variant.Outlined" Immediate="true" />
            <MudTextField @bind-Value="schoolClass" Label="@T("Klasse")" Placeholder="@T("z. B. 2b")" Variant="Variant.Outlined" />
            <MudDatePicker @bind-Date="date" Label="@T("Datum")" Variant="Variant.Outlined" DateFormat="@T("dd.MM.yyyy")" Culture="@culture" />
            <MudButton Class="btn-ink mt-1" Disabled="@string.IsNullOrWhiteSpace(title)" OnClick="CreateAsync" StartIcon="@Icons.Material.Filled.Add">
                @T("Prüfung anlegen")
            </MudButton>
        </MudStack>
    </section>
</div>

@code {
    private static System.Globalization.CultureInfo culture => Language.Culture;
    private static string SettingsLink => $"<a href=\"/einstellungen\">{T("Einstellungen")}</a>";
    private List<ExamSummary>? exams;
    private string title = "";
    private string schoolClass = "";
    private DateTime? date = DateTime.Today;

    private List<ExamSummary> pastSemesters = [];

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        exams = await Repository.ListAsync();
        var today = DateOnly.FromDateTime(DateTime.Today);
        pastSemesters = exams.Where(e => e.PhotoCount > 0 && Semester.HasEnded(e.Date, today)).ToList();
    }

    private async Task DeletePastPhotosAsync()
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            T("Fotos endgültig löschen?"),
            T("Die Fotos von {0} werden gelöscht. Noten, Stufen und Kommentare bleiben. Wer die Rückmeldeblätter mit Fotos braucht, exportiert sie vorher als PDF.",
                string.Join(", ", pastSemesters.Select(e => T("«{0}»", e.Title)))),
            yesText: T("Fotos löschen"),
            cancelText: T("Abbrechen"));
        if (confirmed != true)
        {
            return;
        }
        foreach (var path in await Repository.DeletePhotosAsync(pastSemesters.Select(e => e.Id).ToList()))
        {
            Files.Delete(path);
        }
        await LoadAsync();
    }

    private static string Greeting() =>
        DateTime.Now.Hour switch
        {
            < 11 => T("Guten Morgen"),
            < 17 => T("Guten Tag"),
            _ => T("Guten Abend"),
        };

    private async Task CreateAsync()
    {
        var exam = await Repository.CreateAsync(title, schoolClass, DateOnly.FromDateTime(date ?? DateTime.Today));
        Navigation.NavigateTo($"/pruefung/{exam.Id}");
    }
}
