@page "/pruefung/{ExamId:guid}/arbeit/{SubmissionId:guid}"
@using ArtGrader.Core.Images
@inject ExamRepository Repository
@inject GradingEvents Events
@inject GradingQueue Queue
@inject FileStore Files
@inject ISnackbar Snackbar
@inject SettingsStore Settings
@inject NavigationManager Navigation
@inject CurrentExam Current
@implements IDisposable

<PageTitle>@(submission?.StudentName ?? T("Work")) · ArtGrader</PageTitle>

@if (exam is null || submission is null)
{
    @if (loaded)
    {
        <div class="banner error">@T("This work no longer exists.") <a href="@($"/pruefung/{ExamId}")">@T("Back to the assignment")</a></div>
    }
    else
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Tertiary" />
    }
}
else
{
    var index = exam.Submissions.FindIndex(s => s.Id == submission.Id);
    var previous = index > 0 ? exam.Submissions[index - 1] : null;
    var next = index < exam.Submissions.Count - 1 ? exam.Submissions[index + 1] : null;
    var nextOpen = NextOpen();
    var result = GradeCalculator.Calculate(exam, submission);
    var grade = submission.FinalGradeOverride ?? result.Grade;
    var busy = submission.Status is SubmissionStatus.InWarteschlange or SubmissionStatus.WirdBewertet;

    <ExamHeader Exam="exam" ActiveStep="2" Work="@submission.StudentName">
        <div class="review-head work-bar">
            <div class="student-nav">
                <MudIconButton Icon="@Icons.Material.Outlined.ChevronLeft" Disabled="@(previous is null)" Href="@(previous is null ? null : Url(previous))" aria-label="@T("Previous work")" />
                <div class="@($"student-name {(submission.HasPlaceholderName ? "placeholder-name" : "")}")">
                    <MudTextField T="string" Value="submission.StudentName" ValueChanged="RenameAsync" DebounceInterval="1000" Variant="Variant.Text" aria-label="@T("Name")" />
                    @if (submission.HasPlaceholderName)
                    {
                        <span class="name-hint">@T("Random name – enter the real name")</span>
                    }
                </div>
                <MudIconButton Icon="@Icons.Material.Outlined.ChevronRight" Disabled="@(next is null)" Href="@(next is null ? null : Url(next))" aria-label="@T("Next work")" />
                <span class="faint">@T("{0} of {1}", index + 1, exam.Submissions.Count)</span>
            </div>
            <div class="d-flex align-center flex-wrap gap-2">
                @if (saved)
                {
                    <span class="faint" style="font-size:.85rem">@T("✓ saved")</span>
                }
                <MudButton Class="btn-soft" StartIcon="@Icons.Material.Outlined.AutoAwesome" Disabled="@(busy || !Settings.CanGrade(exam))" OnClick="RegradeAsync">
                    @(submission.GradedAt is null ? T("Get AI suggestion") : T("Reassess"))
                </MudButton>
                <MudButton Class="btn-soft" StartIcon="@Icons.Material.Outlined.PictureAsPdf" Target="_blank"
                           Href="@($"/export/{exam.Id}/beurteilungen.pdf?submission={submission.Id}")">PDF</MudButton>
                @if (submission.Status == SubmissionStatus.Abgeschlossen)
                {
                    <MudButton Class="btn-quiet" OnClick="() => SaveAsync(complete: false)" StartIcon="@Icons.Material.Outlined.LockOpen">@T("Reopen")</MudButton>
                }
                else
                {
                    <MudButton Class="btn-ink" StartIcon="@Icons.Material.Filled.Check" Disabled="@(grade is null || busy)" OnClick="CompleteAsync">
                        @(nextOpen is null ? T("Complete & continue to Grades") : T("Complete & next"))
                    </MudButton>
                }
            </div>
        </div>
    </ExamHeader>

    <div class="review-grid">
        <div class="sticky-side">
            @if (submission.Images.Count > 0)
            {
                var current = submission.Images[Math.Min(imageIndex, submission.Images.Count - 1)];
                @* Shows the photo as the AI sees it; covering and cropping happen in step 2. *@
                <div class="@($"frame {(zoomed ? "zoomed" : "")}")">
                    <img src="@ImageUrls.Covered(current)" alt="@T("Photo {0} of the work", imageIndex + 1)" @onclick="() => zoomed = !zoomed" />
                </div>
            }
            @if (submission.Images.Count > 1)
            {
                <div class="thumbs">
                    @for (var i = 0; i < submission.Images.Count; i++)
                    {
                        var n = i;
                        <img src="@ImageUrls.Covered(submission.Images[n])" class="@(n == imageIndex ? "current" : "")" alt="@T("Photo {0}", n + 1)" @onclick="() => imageIndex = n" />
                    }
                </div>
            }
            <MudButton Class="btn-quiet mt-2" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Edit" Href="@($"/pruefung/{ExamId}/arbeit/{SubmissionId}/bearbeiten")">
                @T("Edit photos")
            </MudButton>
            @if (!string.IsNullOrWhiteSpace(submission.AiDescription))
            {
                <div class="ai-box mt-4">
                    <div class="ai-label"><span class="ai-mark">@T("✦ AI")</span> @T("What the AI sees in the photo")</div>
                    <p>@submission.AiDescription</p>
                </div>
            }
            @if (submission.ModelId is not null)
            {
                <p class="faint" style="font-size:.78rem">@T("Suggestion from") <code>@submission.ModelId</code>@(submission.GradedAt is { } at ? " · " + at.ToString(T("dd/MM/yyyy HH:mm"), Language.Culture) : "")</p>
            }
        </div>

        <div>
            <section class="sheet grade-card">
                <div class="@($"grade-stamp {(grade is null ? "provisional" : "")}")">
                    @(grade?.ToString("0.0#") ?? result.Provisional?.ToString("0.0#") ?? "–")
                    <small>@(grade is null ? T("provisional") : T("Grade"))</small>
                </div>
                <div class="grade-facts">
                    <div class="big">@T("{0:0.##} of {1:0.##} points", result.Points, result.MaxPoints)</div>
                    <div class="muted">
                        @if (result.MissingCount > 0)
                        {
                            <text>@T("{0} criterion/criteria still open for you.", result.MissingCount)</text>
                        }
                        else if (submission.FinalGradeOverride is not null && result.Grade is not null)
                        {
                            <text>@T("The calculated grade would be {0:0.0#}.", result.Grade.Value)</text>
                        }
                        else
                        {
                            <text>@LevelText.Label(submission.Status)</text>
                        }
                    </div>
                    @if (AiOnlyCount() is > 0 and var aiOnly)
                    {
                        <div class="ai-legend mt-2"><span class="ai-mark">@T("✦ AI")</span> @T("{0} of {1} levels are AI suggestions", aiOnly, exam.OrderedCriteria().Count())</div>
                    }
                    @if (busy)
                    {
                        <div class="banner mt-3"><MudProgressCircular Indeterminate="true" Size="Size.Small" Style="color:var(--ink)" /> @T("The AI is looking at the work …")</div>
                    }
                    @if (submission.Status == SubmissionStatus.Fehler)
                    {
                        <div class="banner error mt-3">@submission.ErrorMessage</div>
                    }
                </div>
                <MudNumericField T="decimal?" Value="submission.FinalGradeOverride" ValueChanged="SetOverrideAsync" Label="@T("Set grade yourself")"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="6" Step="0.25m" Clearable="true"
                                 HideSpinButtons="true" Placeholder="@T("e.g. 4.75")" Style="width: 230px; flex: none" />
            </section>

            <section class="sheet">
                <div class="d-flex justify-space-between align-center flex-wrap gap-2 mb-2">
                    <h2 class="sheet-title">@T("Assessment")</h2>
                    <span class="ai-legend"><span class="ai-mark">@T("✦ AI")</span> @T("= AI suggestion · filled with colour = applies")</span>
                </div>
                <div class="d-flex justify-space-between align-center flex-wrap gap-2 mb-2">
                    <span class="faint" style="font-size:.8rem">@T("The AI's justifications only appear in the PDF if you include them when exporting.")</span>
                </div>
                @foreach (var category in exam.Categories)
                {
                    <div class="cat-label">@category.Name</div>
                    @foreach (var criterion in category.Criteria)
                    {
                        var assessment = submission.AssessmentFor(criterion.Id);
                        var teacherOnly = criterion.AssessedBy == AssessedBy.Teacher;
                        <div class="crit">
                            <div class="crit-head">
                                <div class="crit-text">@criterion.Text</div>
                                @if (teacherOnly)
                                {
                                    <span class="tag teacher">@T("Teacher")</span>
                                }
                                else if (assessment.AiConfidence == Confidence.Tief && assessment.TeacherLevel is null)
                                {
                                    <span class="tag unsure">@T("AI unsure")</span>
                                }
                            </div>
                            <div class="levels" role="radiogroup" aria-label="@criterion.Text">
                                @foreach (var level in LevelText.AllDescending)
                                {
                                    var chosen = assessment.EffectiveLevel == level;
                                    var ai = assessment.AiLevel == level;
                                    <button type="button" role="radio" aria-checked="@(chosen ? "true" : "false")"
                                            class="@($"lv-{(int)level} {(chosen ? "chosen" : "")} {(ai ? "ai" : "")}")"
                                            @onclick="() => SetLevelAsync(assessment, level)">
                                        <span class="swatch" style="@($"background:var(--level-{(int)level})")"></span>
                                        <span class="l">@LevelText.Label(level)</span>
                                        <span class="s">@LevelText.Short(level)</span>
                                    </button>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(assessment.AiJustification))
                            {
                                <div class="ai-box why">
                                    <div class="ai-label"><span class="ai-mark">@T("✦ AI")</span> @(assessment.AiLevel is { } aiLevel ? T("AI's justification for ‘{0}’", LevelText.Label(aiLevel)) : T("AI's justification"))</div>
                                    <p>@assessment.AiJustification</p>
                                </div>
                            }
                            @if (assessment.TeacherLevel is not null && assessment.AiLevel is not null && assessment.TeacherLevel != assessment.AiLevel)
                            {
                                <button type="button" class="revert" @onclick="() => SetLevelAsync(assessment, null)">
                                    @T("↺ Use the AI suggestion ({0})", LevelText.Label(assessment.AiLevel.Value))
                                </button>
                            }
                        </div>
                    }
                }
            </section>

            <section class="sheet">
                <h2 class="sheet-title">@T("Feedback")</h2>
                <p class="sheet-sub">@T("‘Your feedback’ appears on the assessment sheet (PDF) for the student. If it stays empty, the AI's feedback appears there instead.")</p>
                @if (!string.IsNullOrWhiteSpace(submission.AiStrengths) || !string.IsNullOrWhiteSpace(submission.AiNextSteps))
                {
                    <div class="ai-box mb-4">
                    <div class="ai-label"><span class="ai-mark">@T("✦ AI")</span> @T("AI suggestion · only for you, not in the PDF")</div>
                    <div class="notes-grid">
                        <div class="note-col">
                            <h4>@T("Strengths")</h4>
                            <ul>@foreach (var line in Lines(submission.AiStrengths)) { <li>@line</li> }</ul>
                        </div>
                        <div class="note-col">
                            <h4>@T("Next steps")</h4>
                            <ul>@foreach (var line in Lines(submission.AiNextSteps)) { <li>@line</li> }</ul>
                        </div>
                    </div>
                    </div>
                }
                <MudTextField T="string" Value="submission.TeacherComment" ValueChanged="SetCommentAsync" Variant="Variant.Outlined" Lines="4" Sizing="InputSizing.Auto"
                              Label="@T("Your feedback")" DebounceInterval="1000" />
                @if (!string.IsNullOrWhiteSpace(submission.AiOverallComment) && submission.TeacherComment != submission.AiOverallComment)
                {
                    <div class="ai-box mt-3">
                        <div class="ai-label"><span class="ai-mark">@T("✦ AI")</span> @T("Feedback as the AI suggests it · appears in the PDF as long as ‘Your feedback’ is empty")</div>
                        <p>«@submission.AiOverallComment»</p>
                    </div>
                    <MudButton Class="btn-quiet mt-1" Size="Size.Small" StartIcon="@Icons.Material.Outlined.ContentPaste" OnClick="() => SetCommentAsync(submission.AiOverallComment)">
                        @T("Use suggestion")
                    </MudButton>
                }
            </section>

            <div class="next-step">
                @if (submission.Status == SubmissionStatus.Abgeschlossen)
                {
                    <span class="muted">@T("Completed.")</span>
                    @if (next is not null)
                    {
                        <MudButton Class="btn-ink" Size="Size.Large" Href="@Url(next)" EndIcon="@Icons.Material.Filled.ArrowForward">@T("Next work")</MudButton>
                    }
                    else
                    {
                        <MudButton Class="btn-ink" Size="Size.Large" OnClick="GoToGrades" EndIcon="@Icons.Material.Filled.ArrowForward">@T("Continue to Grades")</MudButton>
                    }
                }
                else
                {
                    @if (grade is null && !busy && result.MissingCount > 0)
                    {
                        <span class="muted">@T("{0} criterion/criteria still open for you.", result.MissingCount)</span>
                    }
                    <MudButton Class="btn-ink" Size="Size.Large" StartIcon="@Icons.Material.Filled.Check" Disabled="@(grade is null || busy)" OnClick="CompleteAsync">
                        @(nextOpen is null ? T("Complete & continue to Grades") : T("Complete & next"))
                    </MudButton>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid ExamId { get; set; }
    [Parameter] public Guid SubmissionId { get; set; }

    private Exam? exam;
    private Submission? submission;
    private bool loaded;
    private bool saved;
    private int imageIndex;
    private bool zoomed;

    protected override void OnInitialized() => Events.SubmissionChanged += OnSubmissionChanged;

    protected override async Task OnParametersSetAsync()
    {
        imageIndex = 0;
        saved = false;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        exam = await Repository.GetAsync(ExamId);
        submission = exam?.Submissions.FirstOrDefault(s => s.Id == SubmissionId);
        loaded = true;
        Current.Set(exam);
    }

    private string Url(Submission s) => $"/pruefung/{ExamId}/arbeit/{s.Id}";

    private static IEnumerable<string> Lines(string text) =>
        text.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private void OnSubmissionChanged(Guid examId, Guid submissionId)
    {
        if (submissionId == SubmissionId)
        {
            InvokeAsync(async () =>
            {
                await LoadAsync();
                StateHasChanged();
            });
        }
    }

    /// <summary>Criteria whose level comes from the AI and was not set by the teacher.</summary>
    private int AiOnlyCount() =>
        exam!.OrderedCriteria().Count(c => submission!.Assessments.FirstOrDefault(a => a.CriterionId == c.Id) is { TeacherLevel: null, AiLevel: not null });

    private async Task SetLevelAsync(CriterionAssessment assessment, Level? level)
    {
        assessment.TeacherLevel = level is not null && level == assessment.AiLevel ? null : level;
        await SaveAsync(complete: submission!.Status == SubmissionStatus.Abgeschlossen);
    }

    private async Task SetOverrideAsync(decimal? value)
    {
        submission!.FinalGradeOverride = value is null ? null : Math.Clamp(value.Value, 1m, 6m);
        await SaveAsync(complete: submission.Status == SubmissionStatus.Abgeschlossen);
    }

    private async Task SetCommentAsync(string value)
    {
        submission!.TeacherComment = value ?? "";
        await SaveAsync(complete: submission.Status == SubmissionStatus.Abgeschlossen);
    }

    private async Task RenameAsync(string name)
    {
        submission!.StudentName = name;
        await SaveAsync(complete: submission.Status == SubmissionStatus.Abgeschlossen);
    }

    private async Task SaveAsync(bool complete)
    {
        await Repository.SaveReviewAsync(submission!, complete);
        submission!.Status = complete ? SubmissionStatus.Abgeschlossen
            : submission.Status == SubmissionStatus.Abgeschlossen ? SubmissionStatus.Vorschlag : submission.Status;
        saved = true;
        Events.Raise(ExamId, SubmissionId);
    }

    private async Task CompleteAsync()
    {
        if (string.IsNullOrWhiteSpace(submission!.TeacherComment) && !string.IsNullOrWhiteSpace(submission.AiOverallComment))
        {
            submission.TeacherComment = submission.AiOverallComment;
        }
        await SaveAsync(complete: true);
        Snackbar.Add(T("‘{0}’ completed.", submission.StudentName), Severity.Success);
        if (NextOpen() is { } next)
        {
            Navigation.NavigateTo(Url(next));
        }
        else
        {
            GoToGrades();
        }
    }

    /// <summary>The next work still to complete: first after this one, then from the start.</summary>
    private Submission? NextOpen()
    {
        var index = exam!.Submissions.FindIndex(s => s.Id == SubmissionId);
        return exam.Submissions.Skip(index + 1).Concat(exam.Submissions.Take(index))
            .FirstOrDefault(s => s.Status != SubmissionStatus.Abgeschlossen);
    }

    /// <summary>All works are done: open the exam at step 4, «Noten».</summary>
    private void GoToGrades()
    {
        Current.RememberStep(ExamId, 3);
        Navigation.NavigateTo($"/pruefung/{ExamId}");
    }

    private async Task RegradeAsync()
    {
        await Queue.EnqueueAsync(ExamId, [SubmissionId]);
        submission!.Status = SubmissionStatus.InWarteschlange;
    }

    public void Dispose()
    {
        Events.SubmissionChanged -= OnSubmissionChanged;
        Current.Clear(ExamId);
    }
}
