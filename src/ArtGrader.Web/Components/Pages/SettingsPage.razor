@page "/einstellungen"
@using ArtGrader.Core.Ai
@using ArtGrader.Core.Storage
@inject SettingsStore Settings
@inject OllamaGateway Ollama
@inject AppPaths Paths
@inject ISnackbar Snackbar
@inject ModelDownloads Downloads
@inject NavigationManager Navigation
@implements IAsyncDisposable

<PageTitle>@T("Einstellungen") · ArtGrader</PageTitle>

<div class="page-head">
    <div class="eyebrow">@T("Einstellungen")</div>
    <h1 class="page-title">@((MarkupString)T("Wer schaut <em>mit</em>?"))</h1>
    <p class="lede">@T("Wähle, welche KI die Arbeiten vorbewertet. Die Note entscheidest immer du.")</p>
</div>

<div class="flow">
    <section class="sheet">
        <h2 class="sheet-title">@T("Sprache")</h2>
        <p class="sheet-sub">@T("Gilt für ArtGrader, die Beurteilungsbögen und die Texte, die die KI schreibt.")</p>
        <div class="choice-grid" role="radiogroup" aria-label="@T("Sprache")">
            @foreach (var (language, name) in new[] { (AppLanguage.De, "Deutsch"), (AppLanguage.En, "English") })
            {
                var on = Settings.Language == language;
                <button type="button" role="radio" aria-checked="@on" class="@($"choice {(on ? "on" : "")}")" @onclick="() => SetLanguage(language)">
                    <span class="c-title">@name</span>
                </button>
            }
        </div>
    </section>

        <section class="sheet">
            <div class="choice-grid" role="radiogroup" aria-label="@T("KI-Anbieter")">
                <button type="button" role="radio" aria-checked="@(provider == AiProvider.Anthropic)" class="@($"choice {(provider == AiProvider.Anthropic ? "on" : "")}")"
                        @onclick="SelectAnthropic">
                    <span class="c-title"><span class="c-icon" style="background:var(--ultramarine-wash);color:var(--ultramarine)"><MudIcon Icon="@Icons.Material.Outlined.Cloud" /></span>Claude</span>
                    <span class="c-text" style="display:block">@T("Sehr genaue Einschätzungen, 30–60 Sekunden pro Arbeit. Läuft in der Cloud von Anthropic, braucht einen API-Schlüssel und kostet etwa 8 Rappen pro Arbeit.")</span>
                </button>
                <button type="button" role="radio" aria-checked="@(provider == AiProvider.Ollama)" class="@($"choice {(provider == AiProvider.Ollama ? "on" : "")}")"
                        @onclick="SelectOllamaAsync">
                    <span class="c-title"><span class="c-icon" style="background:var(--sage-wash);color:var(--sage)"><MudIcon Icon="@Icons.Material.Outlined.Laptop" /></span>@T("Lokal (Ollama)")</span>
                    <span class="c-text" style="display:block">@T("Alles bleibt auf diesem Computer, kostenlos und offline. Langsamer und weniger genau – braucht viel Arbeitsspeicher (ab 32 GB).")</span>
                </button>
            </div>

            @if (provider == AiProvider.Anthropic)
            {
                <h3 class="sheet-title" style="font-size:1.1rem">@T("Anthropic API-Schlüssel")</h3>
                <p class="sheet-sub">@T("Erstellen unter console.anthropic.com → API Keys. Wird verschlüsselt auf diesem Computer gespeichert.")</p>
                @if (Settings.KeyFromEnvironment)
                {
                    <div class="ok-line mb-3"><MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" /> @T("Schlüssel aus der Umgebungsvariable ANTHROPIC_API_KEY")</div>
                }
                else if (Settings.HasStoredKey)
                {
                    <div class="ok-line mb-3"><MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" /> @T("Ein Schlüssel ist gespeichert")</div>
                }
                <MudTextField @bind-Value="apiKey" @bind-Value:after="Changed" Immediate="true" Label="@(Settings.HasStoredKey ? T("Neuer Schlüssel") : T("API-Schlüssel"))"
                              Variant="Variant.Outlined" InputType="InputType.Password" Placeholder="sk-ant-…" Class="mb-4" autocomplete="off"
                              Error="@(apiKeyError is not null)" ErrorText="@apiKeyError" />
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="7">
                        <MudSelect T="string" @bind-Value="model" @bind-Value:after="Changed" Label="@T("Modell")" Variant="Variant.Outlined">
                            <MudSelectItem T="string" Value="@("claude-opus-5-5")">@T("Claude Opus 5.5 (empfohlen)")</MudSelectItem>
                            <MudSelectItem T="string" Value="@("claude-sonnet-5-5")">@T("Claude Sonnet 5.5 (günstiger)")</MudSelectItem>
                            <MudSelectItem T="string" Value="@("claude-fable-5-1")">@T("Claude Fable 5.1 (stärkstes, teuerstes)")</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="5">
                        <MudSelect T="string" @bind-Value="effort" @bind-Value:after="Changed" Label="@T("Gründlichkeit")" Variant="Variant.Outlined">
                            <MudSelectItem T="string" Value="@("medium")">@T("Mittel")</MudSelectItem>
                            <MudSelectItem T="string" Value="@("high")">@T("Hoch (empfohlen)")</MudSelectItem>
                            <MudSelectItem T="string" Value="@("max")">@T("Maximal")</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                </MudGrid>
            }
            else
            {
                <h3 class="sheet-title" style="font-size:1.1rem">@T("Lokales Modell")</h3>
                <p class="sheet-sub">
                    @((MarkupString)T("Einmalig <a href='https://ollama.com/download' target='_blank' rel='noopener'>Ollama installieren</a> und starten."))
                    @T("Danach hier ein Modell herunterladen und auswählen.")
                </p>
                @if (ollamaError is not null)
                {
                    <div class="banner error mb-3">@ollamaError</div>
                }
                else if (ollamaReachable)
                {
                    <div class="ok-line mb-3"><MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" /> @T("Ollama läuft")</div>
                }

                <div class="model-list" role="radiogroup" aria-label="@T("Lokales Modell")">
                    @foreach (var entry in LocalModelCatalog.Recommended)
                    {
                        var installed = IsInstalled(entry.Name);
                        var download = Downloads.Get(entry.Name);
                        <div class="@($"model-card {(ollamaModel == entry.Name ? "on" : "")} {(installed ? "" : "missing")}")">
                            <button type="button" role="radio" aria-checked="@(ollamaModel == entry.Name)" class="model-pick" disabled="@(!installed)"
                                    @onclick="() => PickModel(entry.Name)">
                                <span class="model-head">
                                    <span class="model-title">@entry.Title</span>
                                    <code>@entry.Name</code>
                                </span>
                                <span class="model-text">@entry.Description</span>
                                <span class="model-facts">
                                    <span>⏱ @T("{0} Min. pro Arbeit", effort == "high" ? entry.MinutesWithThinking : entry.MinutesFast)</span>
                                    <span>@entry.DownloadGb.ToString("0.#") GB</span>
                                    <span>@T("ab {0} GB Arbeitsspeicher", entry.MinMemoryGb)</span>
                                </span>
                            </button>
                            <div class="model-action">
                                @if (installed)
                                {
                                    <span class="ok-line"><MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" /> @T("installiert")</span>
                                }
                                else if (download is { Error: { } error })
                                {
                                    <span class="work-error">@error</span>
                                }
                                else if (download is not null)
                                {
                                    var fraction = download.Progress?.Fraction ?? 0;
                                    <div class="brush-progress" style="min-width:140px"><span style="@($"width:{(fraction * 100).ToString("0", System.Globalization.CultureInfo.InvariantCulture)}%")"></span></div>
                                    <span class="faint" style="font-size:.8rem">@(download.Progress?.Fraction is { } f ? $"{f:P0}" : T("startet …"))</span>
                                }
                                else
                                {
                                    <MudButton Class="btn-soft" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Download" Disabled="@(!ollamaReachable)"
                                               OnClick="() => Downloads.Start(entry.Name)">
                                        @T("Herunterladen")
                                    </MudButton>
                                }
                            </div>
                        </div>
                    }
                    @foreach (var other in models.Where(m => !LocalModelCatalog.IsKnown(m.Name)))
                    {
                        <div class="@($"model-card {(ollamaModel == other.Name ? "on" : "")}")">
                            <button type="button" role="radio" aria-checked="@(ollamaModel == other.Name)" class="model-pick" @onclick="() => PickModel(other.Name)">
                                <span class="model-head"><span class="model-title">@T("Weiteres Modell")</span><code>@other.Name</code></span>
                                <span class="model-text">@T("Selbst installiert. Muss Bilder verstehen können (Vision).")</span>
                                <span class="model-facts"><span>@((other.SizeBytes / 1_000_000_000.0).ToString("0.#")) GB</span></span>
                            </button>
                            <div class="model-action"><span class="ok-line"><MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" /> @T("installiert")</span></div>
                        </div>
                    }
                </div>
                @if (hiddenCloudModels > 0)
                {
                    <div class="banner info mt-3">
                        <MudIcon Icon="@Icons.Material.Outlined.CloudOff" />
                        <span>@(hiddenCloudModels == 1 ? T("1 Cloud-Modell ist ausgeblendet.") : T("{0} Cloud-Modelle sind ausgeblendet.", hiddenCloudModels)) @T("Cloud-Modelle von Ollama rechnen auf fremden Servern; die Fotos würden den Computer verlassen.")</span>
                    </div>
                }
                <p class="faint mt-2" style="font-size:.8rem">@T("Zeiten gemessen auf dem Testcomputer mit 14 Arbeiten. Je nach Computer schneller oder langsamer.")</p>

                <h3 class="sheet-title mt-6" style="font-size:1.1rem">@T("Modus")</h3>
                <div class="choice-grid" role="radiogroup" aria-label="@T("Modus")" style="margin-bottom:8px">
                    <button type="button" role="radio" aria-checked="@(effort == "high")" class="@($"choice {(effort == "high" ? "on" : "")}")" @onclick="@(() => SetEffort("high"))">
                        <span class="c-title">@T("Gründlich")</span>
                        <span class="c-text">@T("Das Modell denkt nach, bevor es antwortet. Genauer, aber etwa doppelt so lang.")</span>
                    </button>
                    <button type="button" role="radio" aria-checked="@(effort == "medium")" class="@($"choice {(effort == "medium" ? "on" : "")}")" @onclick="@(() => SetEffort("medium"))">
                        <span class="c-title">@T("Schnell")</span>
                        <span class="c-text">@T("Antwortet direkt ohne Nachdenken. Gut, wenn viele Arbeiten anstehen.")</span>
                    </button>
                </div>
                @if (effort == "medium" && LocalModelCatalog.Find(ollamaModel) is { FastVariant: { } fastVariant } selectedModel && !IsInstalled(fastVariant))
                {
                    var fastDownload = Downloads.Get(fastVariant);
                    <div class="model-card missing" style="margin-top:12px">
                        <div class="model-pick" style="cursor:default">
                            <span class="model-head"><span class="model-title">@T("Schnell-Variante für «{0}»", selectedModel.Title)</span><code>@fastVariant</code></span>
                            <span class="model-text">@T("Dieses Modell kann das Nachdenken nicht abschalten. Für den Schnell-Modus braucht es eine zweite Variante. Bis sie geladen ist, denkt es trotzdem nach.")</span>
                            <span class="model-facts"><span>@selectedModel.DownloadGb.ToString("0.#") GB</span></span>
                        </div>
                        <div class="model-action">
                            @if (fastDownload is { Error: { } fastError })
                            {
                                <span class="work-error">@fastError</span>
                            }
                            else if (fastDownload is not null)
                            {
                                var fastFraction = fastDownload.Progress?.Fraction ?? 0;
                                <div class="brush-progress" style="min-width:140px"><span style="@($"width:{(fastFraction * 100).ToString("0", System.Globalization.CultureInfo.InvariantCulture)}%")"></span></div>
                                <span class="faint" style="font-size:.8rem">@(fastDownload.Progress?.Fraction is { } ff ? $"{ff:P0}" : T("startet …"))</span>
                            }
                            else
                            {
                                <MudButton Class="btn-soft" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Download" Disabled="@(!ollamaReachable)"
                                           OnClick="() => Downloads.Start(fastVariant)">
                                    @T("Herunterladen")
                                </MudButton>
                            }
                        </div>
                    </div>
                }

                <MudGrid Spacing="2" Class="mt-2">
                    <MudItem xs="12" sm="8">
                        <MudTextField @bind-Value="ollamaUrl" @bind-Value:after="Changed" Immediate="true" Label="@T("Ollama-Adresse")" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="4" Class="d-flex align-center">
                        <MudButton Class="btn-quiet" StartIcon="@Icons.Material.Outlined.Sync" OnClick="LoadModelsAsync" Disabled="@checking">
                            @(checking ? T("Prüfe …") : T("Neu prüfen"))
                        </MudButton>
                    </MudItem>
                </MudGrid>
            }

            @if (provider == AiProvider.Anthropic && Settings.HasStoredKey)
            {
                <div class="d-flex justify-end mt-4">
                    <MudButton Class="btn-quiet" Color="Color.Secondary" OnClick="RemoveKey">@T("Schlüssel entfernen")</MudButton>
                </div>
            }
            <p class="faint mt-4" style="font-size:.85rem">@T("Änderungen werden automatisch gespeichert.")</p>
        </section>
        <section class="sheet">
            <h2 class="sheet-title">@T("Immer schwärzen")</h2>
            <p class="sheet-sub">
                @T("Begriffe, die auf deine Schule hinweisen: Schulhaus, Ort, dein Name und dein Kürzel. ArtGrader schlägt sie in jedem Dokument zum Schwärzen vor.")
                @T("E-Mail-Adressen, Telefonnummern und Webadressen erkennt ArtGrader selbst.")
            </p>
            <MudTextField T="string" @bind-Value="redactTerms" @bind-Value:after="RedactTermsChanged" Immediate="true" Label="@T("Ein Begriff pro Zeile")"
                          Variant="Variant.Outlined" Lines="5" Placeholder="@TermsPlaceholder" />
        </section>
        <section class="sheet">
            <h2 class="sheet-title">@T("Datenschutz")</h2>
            <p class="muted" style="font-size:.93rem">
                @T("Prüfungen, Fotos und Noten bleiben auf diesem Computer.")
                @((MarkupString)T("Mit Claude gehen nur Aufgabe, Kriterien und Fotos an Anthropic – <b>keine Namen</b>."))
                @T("Mit dem lokalen Modell verlässt nichts den Computer.")
            </p>
            <p class="faint" style="font-size:.88rem">@T("Auf den Fotos sollten keine Namen zu sehen sein. Kläre die Nutzung mit deiner Schulleitung ab.")</p>
            <MudButton Href="schulleitung.html" Target="_blank" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Description" Class="mt-2">
                @T("Übersicht für die Schulleitung")
            </MudButton>
        </section>
        <section class="sheet">
            <h2 class="sheet-title">@T("Datenordner")</h2>
            <p style="word-break:break-all"><code>@Paths.Root</code></p>
            <p class="faint" style="font-size:.88rem">@T("Für ein Backup diesen Ordner kopieren, während ArtGrader geschlossen ist.")</p>
        </section>
</div>

@code {
    private AiProvider provider;
    private string apiKey = "";
    private string model = AiSettings.DefaultModel;
    private string effort = AiSettings.DefaultEffort;
    private string ollamaUrl = AiSettings.DefaultOllamaUrl;
    private string? ollamaModel;
    private IReadOnlyList<OllamaModelInfo> models = [];
    private int hiddenCloudModels;
    private static string TermsPlaceholder => T("z. B. Schulhaus Musterdorf, Musterdorf, A. Beispiel – je eine Zeile");
    private string redactTerms = "";

    private readonly Debouncer saver = new();
    private readonly Debouncer termsSaver = new();
    private string? apiKeyError;

    private void RedactTermsChanged() => termsSaver.Schedule(() => InvokeAsync(SaveRedactTerms));

    private void SaveRedactTerms() =>
        Settings.SaveRedactTerms(redactTerms.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries));

    private void Changed() => saver.Schedule(() => InvokeAsync(Save));

    private void SelectAnthropic()
    {
        provider = AiProvider.Anthropic;
        Changed();
    }

    private void PickModel(string name)
    {
        ollamaModel = name;
        Changed();
    }

    private void SetLanguage(AppLanguage language)
    {
        if (language == Settings.Language)
        {
            return;
        }
        Settings.SaveLanguage(language);
        // Reload so every part of the page, including the layout, is drawn in the new language.
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }

    private void SetEffort(string value)
    {
        effort = value;
        Changed();
    }
    private string? ollamaError;
    private bool ollamaReachable;
    private bool checking;
    private int completedDownloads;

    private bool IsInstalled(string name) => models.Any(m => m.Name == name);

    private void OnDownloadsChanged() => InvokeAsync(async () =>
    {
        var done = LocalModelCatalog.Recommended
            .SelectMany(m => new[] { m.Name, m.FastVariant })
            .Count(name => name is not null && Downloads.Get(name)?.Done == true);
        if (done != completedDownloads)
        {
            completedDownloads = done;
            await LoadModelsAsync();
        }
        StateHasChanged();
    });

    public async ValueTask DisposeAsync()
    {
        Downloads.Changed -= OnDownloadsChanged;
        await saver.DisposeAsync();
        await termsSaver.DisposeAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        Downloads.Changed += OnDownloadsChanged;
        provider = Settings.Provider;
        model = Settings.Model;
        effort = Settings.Effort;
        ollamaUrl = Settings.OllamaUrl;
        redactTerms = string.Join("\n", Settings.RedactTerms);
        ollamaModel = Settings.OllamaModel;
        if (provider == AiProvider.Ollama)
        {
            await LoadModelsAsync();
        }
    }

    private async Task SelectOllamaAsync()
    {
        provider = AiProvider.Ollama;
        if (effort is not ("medium" or "high"))
        {
            effort = "high";
        }
        if (models.Count == 0)
        {
            await LoadModelsAsync();
        }
        Changed();
    }

    private async Task LoadModelsAsync()
    {
        checking = true;
        ollamaError = null;
        try
        {
            var all = await Ollama.ListModelsAsync(ollamaUrl, CancellationToken.None);
            models = all.Where(m => !m.Cloud).ToList();
            hiddenCloudModels = all.Count(m => m.Cloud);
            if (ollamaModel is not null && all.Any(m => m.Cloud && m.Name == ollamaModel))
            {
                ollamaModel = null;
            }
            ollamaReachable = true;
            if (models.Count > 0 && (ollamaModel is null || models.All(m => m.Name != ollamaModel)))
            {
                ollamaModel = LocalModelCatalog.Recommended.FirstOrDefault(r => IsInstalled(r.Name))?.Name ?? models[0].Name;
            }
        }
        catch (ModelException ex)
        {
            models = [];
            ollamaReachable = false;
            ollamaError = ex.Message;
        }
        finally
        {
            checking = false;
        }
    }

    private void Save()
    {
        // A half-typed or wrong key is not saved; the other settings are.
        apiKeyError = null;
        var key = apiKey;
        if (provider == AiProvider.Anthropic && !string.IsNullOrWhiteSpace(apiKey) && !apiKey.Trim().StartsWith("sk-ant-", StringComparison.Ordinal))
        {
            apiKeyError = T("Das sieht nicht nach einem Anthropic-Schlüssel aus (beginnt mit «sk-ant-»).");
            key = "";
        }
        if (provider == AiProvider.Ollama && string.IsNullOrWhiteSpace(ollamaModel))
        {
            // Without a model the local choice is not usable yet; keep the saved settings until one is picked.
            StateHasChanged();
            return;
        }
        if (provider == AiProvider.Ollama && !string.IsNullOrWhiteSpace(ollamaUrl) && !OllamaGateway.IsThisComputer(ollamaUrl))
        {
            // An address on another machine is not saved; the last local address stays.
            ollamaError = OllamaGateway.NotThisComputer(ollamaUrl);
        }
        Settings.Save(new SettingsUpdate(provider, key, model, effort, ollamaUrl, ollamaModel));
        if (!string.IsNullOrWhiteSpace(key))
        {
            apiKey = "";
            Snackbar.Add(T("Schlüssel gespeichert."), Severity.Success);
        }
        StateHasChanged();
    }

    private void RemoveKey()
    {
        Settings.RemoveKey();
        Snackbar.Add(T("Schlüssel entfernt."), Severity.Info);
    }
}
