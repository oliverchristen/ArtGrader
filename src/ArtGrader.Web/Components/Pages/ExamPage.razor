@page "/pruefung/{Id:guid}"
@inject ExamRepository Repository
@inject GradingEvents Events
@inject NavigationManager Navigation
@inject IDialogService Dialogs
@inject FileStore Files
@inject CurrentExam Current
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>@(exam?.Title ?? "Prüfung") · ArtGrader</PageTitle>

@if (notFound)
{
    <div class="banner error">Diese Prüfung gibt es nicht (mehr). <a href="/">Zur Übersicht</a></div>
}
else if (exam is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Tertiary" />
}
else
{
    var criteriaCount = exam.OrderedCriteria().Count();
    var completed = exam.Submissions.Count(s => s.Status == SubmissionStatus.Abgeschlossen);
    <div class="exam-head">
        <nav class="crumbs"><a href="/">Prüfungen</a><span>/</span><span>@exam.Title</span></nav>
        <div class="review-head">
            <div class="exam-head-main">
                <div class="exam-meta-edit">
                    <label class="meta-field">
                        <span>Klasse</span>
                        <input value="@schoolClass" @oninput="OnClassInput" placeholder="–" size="@Math.Max(5, schoolClass.Length + 2)" maxlength="40" aria-label="Klasse" />
                    </label>
                    <span aria-hidden="true">·</span>
                    <label class="meta-field">
                        <input type="date" value="@date.ToString("yyyy-MM-dd")" @onchange="OnDateChanged" aria-label="Datum" />
                    </label>
                </div>
                <input class="page-title title-input" value="@title" @oninput="OnTitleInput" @onblur="OnTitleBlur"
                       aria-label="Titel der Prüfung" placeholder="Titel" maxlength="200" />
            </div>
            <MudButton Class="btn-quiet" Color="Color.Secondary" StartIcon="@Icons.Material.Outlined.Delete" OnClick="DeleteAsync">Prüfung löschen</MudButton>
        </div>

        <div class="steps" role="tablist">
            @foreach (var (index, title, done) in Steps(criteriaCount, completed))
            {
                var tab = index;
                <button type="button" role="tab" aria-selected="@(activeTab == tab)" class="@StepClass(tab, done)" @onclick="() => GoToTabAsync(tab)">
                    <span class="num">@(done && activeTab != tab ? "✓" : (tab + 1).ToString())</span> @title
                    @if (tab == 2 && running > 0)
                    {
                        <span class="badge">@running läuft</span>
                    }
                </button>
            }
        </div>
    </div>

    @switch (activeTab)
    {
        case 0:
            <ExamSetupPanel Exam="exam" Changed="ReloadAsync" Next="() => GoToTabAsync(1)" />
            break;
        case 1:
            <SubmissionsPanel Exam="exam" Changed="ReloadAsync" ShowStep="GoToTabAsync" Next="() => GoToTabAsync(2)" />
            break;
        case 2:
            <SubmissionsPanel Exam="exam" Changed="ReloadAsync" Grading="true" ShowStep="GoToTabAsync" Next="() => GoToTabAsync(3)" />
            break;
        default:
            <OverviewPanel Exam="exam" />
            break;
    }
}

@code {
    private static readonly System.Globalization.CultureInfo culture = new("de-CH");

    [Parameter] public Guid Id { get; set; }

    private Exam? exam;
    private bool notFound;
    private int activeTab;
    private int running;
    private readonly Debouncer headerSaver = new();
    private string title = "";
    private string schoolClass = "";
    private DateOnly date;

    private void OnTitleInput(ChangeEventArgs e)
    {
        title = e.Value?.ToString() ?? "";
        ScheduleHeaderSave();
    }

    private void OnTitleBlur()
    {
        if (string.IsNullOrWhiteSpace(title))
        {
            title = exam!.Title;
        }
    }

    private void OnClassInput(ChangeEventArgs e)
    {
        schoolClass = e.Value?.ToString() ?? "";
        ScheduleHeaderSave();
    }

    private void OnDateChanged(ChangeEventArgs e)
    {
        if (DateOnly.TryParse(e.Value?.ToString(), System.Globalization.CultureInfo.InvariantCulture, out var value))
        {
            date = value;
            ScheduleHeaderSave();
        }
    }

    private void ScheduleHeaderSave() => headerSaver.Schedule(() => InvokeAsync(SaveHeaderAsync));

    private async Task SaveHeaderAsync()
    {
        if (exam is null)
        {
            return;
        }
        await Repository.SaveExamHeaderAsync(exam.Id, title, schoolClass, date);
        exam.Title = string.IsNullOrWhiteSpace(title) ? exam.Title : title.Trim();
        exam.SchoolClass = schoolClass.Trim();
        exam.Date = date;
        StateHasChanged();
    }

    private async Task GoToTabAsync(int tab)
    {
        activeTab = tab;
        Current.RememberStep(Id, tab);
        try
        {
            await JS.InvokeVoidAsync("scrollTo", 0, 0);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException)
        {
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Events.SubmissionChanged += OnSubmissionChanged;
        await ReloadAsync();
        if (exam is not null)
        {
            activeTab = Current.LastStep(Id) ?? (exam.Categories.Count == 0 ? 0 : exam.Submissions.Count == 0 ? 1 : 2);
        }
    }

    private IEnumerable<(int Index, string Title, bool Done)> Steps(int criteriaCount, int completed)
    {
        var works = exam!.Submissions.Count;
        yield return (0, "Aufgabe & Kriterien", criteriaCount > 0);
        yield return (1, "Arbeiten erfassen", works > 0);
        yield return (2, "Arbeiten bewerten", works > 0 && exam.Submissions.All(s => s.GradedAt is not null));
        yield return (3, "Übersicht & Export", works > 0 && completed == works);
    }

    private string StepClass(int index, bool done) =>
        $"step {(activeTab == index ? "active" : "")} {(done ? "done" : "")}";

    private async Task ReloadAsync()
    {
        exam = await Repository.GetAsync(Id);
        notFound = exam is null;
        Current.Set(exam);
        if (exam is not null && !headerSaver.IsPending)
        {
            title = exam.Title;
            schoolClass = exam.SchoolClass;
            date = exam.Date;
        }
        if (exam is not null)
        {
            running = exam.Submissions.Count(s => s.Status is SubmissionStatus.InWarteschlange or SubmissionStatus.WirdBewertet);
        }
    }

    private void OnSubmissionChanged(Guid examId, Guid submissionId)
    {
        if (examId == Id)
        {
            InvokeAsync(async () =>
            {
                await ReloadAsync();
                StateHasChanged();
            });
        }
    }

    private async Task DeleteAsync()
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            "Prüfung löschen?",
            $"«{exam!.Title}» mit allen {exam.Submissions.Count} Arbeiten, Fotos und Bewertungen wird endgültig gelöscht.",
            yesText: "Löschen",
            cancelText: "Abbrechen");
        if (confirmed == true)
        {
            await Repository.DeleteExamAsync(exam.Id);
            Files.DeleteExamFolder(exam.Id);
            Navigation.NavigateTo("/");
        }
    }

    public async ValueTask DisposeAsync()
    {
        Events.SubmissionChanged -= OnSubmissionChanged;
        await headerSaver.DisposeAsync();
        Current.Clear(Id);
    }
}
