@page "/pruefung/{ExamId:guid}/arbeit/{SubmissionId:guid}/bearbeiten"
@using ArtGrader.Core.Images
@inject ExamRepository Repository
@inject GradingEvents Events
@inject FileStore Files
@inject ISnackbar Snackbar
@inject CurrentExam Current
@inject NavigationManager Navigation
@implements IDisposable

@* Step 2: prepare one work before the AI sees it – name, cover, crop, add, remove or split off photos. *@

<PageTitle>@(submission?.StudentName ?? T("Arbeit")) · ArtGrader</PageTitle>

@if (exam is null || submission is null)
{
    @if (loaded)
    {
        <div class="banner error">@T("Diese Arbeit gibt es nicht (mehr).") <a href="@ExamUrl">@T("Zur Prüfung")</a></div>
    }
    else
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Tertiary" />
    }
}
else
{
    var index = exam.Submissions.FindIndex(s => s.Id == submission.Id);
    var previous = index > 0 ? exam.Submissions[index - 1] : null;
    var next = index < exam.Submissions.Count - 1 ? exam.Submissions[index + 1] : null;
    var current = submission.Images.Count == 0 ? null : submission.Images[Math.Min(imageIndex, submission.Images.Count - 1)];

    <ExamHeader Exam="exam" ActiveStep="1" Work="@submission.StudentName">
        <div class="review-head work-bar">
            <div class="student-nav">
                <MudIconButton Icon="@Icons.Material.Outlined.ChevronLeft" Disabled="@(previous is null)" Href="@(previous is null ? null : EditUrl(previous))" aria-label="@T("Vorherige Arbeit")" />
                <div class="@($"student-name {(submission.HasPlaceholderName ? "placeholder-name" : "")}")">
                    <MudTextField T="string" Value="submission.StudentName" ValueChanged="RenameAsync" DebounceInterval="1000" Variant="Variant.Text" aria-label="@T("Name")" />
                    @if (submission.HasPlaceholderName)
                    {
                        <span class="name-hint">@T("Zufallsname – echten Namen eintragen")</span>
                    }
                </div>
                <MudIconButton Icon="@Icons.Material.Outlined.ChevronRight" Disabled="@(next is null)" Href="@(next is null ? null : EditUrl(next))" aria-label="@T("Nächste Arbeit")" />
                <span class="faint">@T("{0} von {1}", index + 1, exam.Submissions.Count)</span>
            </div>
        </div>
    </ExamHeader>

    <div class="flow">
        <div class="banner info">
            <MudIcon Icon="@Icons.Material.Outlined.VisibilityOff" />
            <span>@T("Steht ein Name oder eine Signatur auf dem Werk? Decke die Stelle ab. Die KI sieht nur das bearbeitete Foto.")</span>
        </div>

        @if (current is not null)
        {
            <CoverEditor @key="current.Id" Src="@ImageUrls.Original(current)" Covers="current.Covers" Crop="current.Crop" ItemId="current.Id"
                         Alt="@T("Foto {0} der Arbeit", imageIndex + 1)" Save="edits => SaveImageEditsAsync(current, edits)" />
        }

        <section class="sheet">
            <h2 class="sheet-title">@T("Fotos dieser Arbeit")</h2>
            <p class="sheet-sub">@T("Weitere Fotos hinzufügen, zum Beispiel Details oder die Rückseite. Ein Foto, das zu einer anderen Arbeit gehört, als eigene Arbeit abtrennen.")</p>
            <div class="thumbs">
                @for (var i = 0; i < submission.Images.Count; i++)
                {
                    var n = i;
                    <img src="@ImageUrls.Covered(submission.Images[n])" class="@(n == imageIndex ? "current" : "")" alt="@T("Foto {0}", n + 1)" @onclick="() => imageIndex = n" />
                }
                <label class="add-photo" title="@T("Weiteres Foto (Detail, Rückseite …)")">
                    <InputFile OnChange="AddPhotosAsync" multiple accept=".jpg,.jpeg,.png,.webp,.gif,.bmp,.heic" aria-label="@T("Foto hinzufügen")" />
                    <MudIcon Icon="@Icons.Material.Outlined.Add" />
                </label>
            </div>
            @if (submission.Images.Count > 1)
            {
                <div class="d-flex flex-wrap gap-2 mt-3">
                    <MudButton Class="btn-soft" Size="Size.Small" StartIcon="@Icons.Material.Outlined.CallSplit" OnClick="SplitCurrentPhotoAsync">
                        @T("Als eigene Arbeit abtrennen")
                    </MudButton>
                    <MudButton Class="btn-quiet" Size="Size.Small" Color="Color.Secondary" StartIcon="@Icons.Material.Outlined.DeleteOutline" OnClick="RemoveCurrentPhotoAsync">
                        @T("Dieses Foto entfernen")
                    </MudButton>
                </div>
            }
        </section>

        <div class="next-step">
            <MudButton Class="btn-quiet" Href="@ExamUrl" StartIcon="@Icons.Material.Filled.ArrowBack">@T("Zurück zu den Arbeiten")</MudButton>
            @if (next is not null)
            {
                <MudButton Class="btn-ink" Size="Size.Large" Href="@EditUrl(next)" EndIcon="@Icons.Material.Filled.ArrowForward">@T("Nächste Arbeit")</MudButton>
            }
            else
            {
                <MudButton Class="btn-ink" Size="Size.Large" OnClick="GoToAssessing" EndIcon="@Icons.Material.Filled.ArrowForward">@T("Weiter zu Arbeiten bewerten")</MudButton>
            }
        </div>
    </div>
}

@code {
    private const long MaxImageBytes = 40 * 1024 * 1024;

    [Parameter] public Guid ExamId { get; set; }
    [Parameter] public Guid SubmissionId { get; set; }

    private Exam? exam;
    private Submission? submission;
    private bool loaded;
    private int imageIndex;

    private string ExamUrl => $"/pruefung/{ExamId}";

    private string EditUrl(Submission s) => $"/pruefung/{ExamId}/arbeit/{s.Id}/bearbeiten";

    protected override async Task OnParametersSetAsync()
    {
        imageIndex = 0;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        exam = await Repository.GetAsync(ExamId);
        submission = exam?.Submissions.FirstOrDefault(s => s.Id == SubmissionId);
        loaded = true;
        Current.Set(exam);
    }

    /// <summary>After the last work: open the exam at step 3, «Arbeiten bewerten».</summary>
    private void GoToAssessing()
    {
        Current.RememberStep(ExamId, 2);
        Navigation.NavigateTo(ExamUrl);
    }

    private async Task RenameAsync(string name)
    {
        (submission!.StudentName, submission.HasPlaceholderName) = await Repository.RenameSubmissionAsync(SubmissionId, name);
        Events.Raise(ExamId, SubmissionId);
    }

    private async Task SaveImageEditsAsync(SubmissionImage image, ImageEdits edits)
    {
        await Repository.SetImageEditsAsync(image.Id, edits.Covers, edits.Crop);
        image.Covers = edits.Covers;
        image.Crop = edits.Crop;
        Events.Raise(ExamId, SubmissionId);
    }

    private async Task AddPhotosAsync(InputFileChangeEventArgs e)
    {
        var images = new List<SubmissionImage>();
        foreach (var file in e.GetMultipleFiles(20))
        {
            try
            {
                if (file.Size > MaxImageBytes)
                {
                    throw new UnsupportedImageException(T("grösser als 40 MB"));
                }
                await using var stream = file.OpenReadStream(MaxImageBytes);
                images.Add(new SubmissionImage { OriginalName = "", RelativePath = await Files.SaveSubmissionImageAsync(ExamId, stream, CancellationToken.None) });
            }
            catch (UnsupportedImageException ex)
            {
                Snackbar.Add(T("{0}: {1}", file.Name, ex.Message), Severity.Error);
            }
        }
        if (images.Count > 0)
        {
            await Repository.AddImagesAsync(SubmissionId, images);
            await LoadAsync();
            imageIndex = submission!.Images.Count - 1;
            Events.Raise(ExamId, SubmissionId);
        }
    }

    private async Task SplitCurrentPhotoAsync()
    {
        var image = submission!.Images[Math.Min(imageIndex, submission.Images.Count - 1)];
        var split = await Repository.SplitImageAsync(image.Id);
        if (split is null)
        {
            return;
        }
        imageIndex = 0;
        await LoadAsync();
        Events.Raise(ExamId, split.Id);
        Snackbar.Add(
            submission.GradedAt is null
                ? T("Das Foto ist jetzt die eigene Arbeit «{0}».", split.StudentName)
                : T("Das Foto ist jetzt die eigene Arbeit «{0}». Diese Arbeit bei Bedarf neu bewerten lassen; der KI-Vorschlag bezog beide Fotos ein.", split.StudentName),
            Severity.Success);
    }

    private async Task RemoveCurrentPhotoAsync()
    {
        var image = submission!.Images[Math.Min(imageIndex, submission.Images.Count - 1)];
        foreach (var removed in await Repository.RemoveImageAsync(image.Id))
        {
            Files.Delete(removed.RelativePath);
        }
        imageIndex = 0;
        await LoadAsync();
        Events.Raise(ExamId, SubmissionId);
    }

    public void Dispose() => Current.Clear(ExamId);
}
