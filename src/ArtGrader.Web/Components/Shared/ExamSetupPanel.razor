@using ArtGrader.Core.Ai
@using ArtGrader.Core.Images
@inject ExamRepository Repository
@inject FileStore Files
@inject RubricImportService RubricImport
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject SettingsStore Settings
@implements IAsyncDisposable

<div class="flow">
    <section class="sheet">
        <h2 class="sheet-title">@T("Datenschutz")</h2>
        <div class="@($"privacy-choice {(grading.LocalOnly ? "on" : "")}")">
            <MudSwitch T="bool" Value="grading.LocalOnly" ValueChanged="SetLocalOnlyAsync" Color="Color.Success" Label="@T("Nur lokal bewerten")" />
            <p>
                @if (grading.LocalOnly)
                {
                    @(string.IsNullOrWhiteSpace(Settings.OllamaModel)
                        ? T("Dokumente, Fotos und Kriterien dieser Prüfung gehen nie ins Internet. Bewertet wird mit dem lokalen Modell.")
                        : T("Dokumente, Fotos und Kriterien dieser Prüfung gehen nie ins Internet. Bewertet wird mit dem lokalen Modell «{0}».", Settings.OllamaModel))
                }
                else
                {
                    @T("Einschalten, wenn für diese Prüfung nichts in die Cloud gehen darf. Das lokale Modell ist langsamer und etwas weniger genau.")
                }
            </p>
            @if (grading.LocalOnly && string.IsNullOrWhiteSpace(Settings.OllamaModel))
            {
                <div class="banner mt-2">@T("Es ist noch kein lokales Modell eingerichtet.") <a href="/einstellungen">@T("Zu den Einstellungen")</a></div>
            }
        </div>
    </section>

    <DocumentSection Exam="Exam" Kind="DocumentKind.Aufgabe" Title="@T("Aufgabenstellung")"
                     Sub="@T("Das Blatt, das die Klasse bekommen hat. Die KI liest es, um zu verstehen, worum es geht.")"
                     DropText="@T("Word, PDF oder Text hierher ziehen")" TextLabel="@T("Text der Aufgabe")"
                     Placeholder="@T("Aufgabe hochladen oder hier eintippen")" Changed="OnDocumentChanged" />

    <DocumentSection Exam="Exam" Kind="DocumentKind.Unterricht" Title="@T("Unterrichtsmaterial")" Optional="true"
                     Sub="@T("Zum Beispiel die PowerPoint-Präsentation zum Thema. So weiss die KI, was im Unterricht behandelt wurde.")"
                     DropText="@T("PowerPoint, PDF oder Word hierher ziehen")" TextLabel="@T("Text aus dem Unterrichtsmaterial")" Rows="8"
                     Changed="OnDocumentChanged" />

    <DocumentSection Exam="Exam" Kind="DocumentKind.Beurteilung" Title="@T("Beurteilungsbogen")"
                     Sub="@T("Hochladen, prüfen und schwärzen. Dann liest die KI die Kriterien daraus aus.")"
                     DropText="@T("Beurteilungsbogen hierher ziehen")" TextLabel="@T("Text des Beurteilungsbogens")" Changed="OnDocumentChanged">
        <Footer>
            <MudButton Class="btn-ink" StartIcon="@Icons.Material.Filled.AutoAwesome" Disabled="@(importing || !HasRubricSource)" OnClick="ImportRubricAsync">
                @(importing ? T("Die KI liest …") : T("Kriterien auslesen"))
            </MudButton>
        </Footer>
    </DocumentSection>

    <section class="sheet">
        <h2 class="sheet-title">@T("Beurteilungskriterien")</h2>
        <p class="sheet-sub">@T("Aus dem Beurteilungsbogen auslesen oder selbst erfassen. Danach kannst du alles anpassen.")</p>

        @if (categories.Count == 0)
        {
            <p class="faint mt-4">@T("Noch keine Kriterien.")</p>
        }

        @foreach (var category in categories)
        {
            <div class="category" @key="category.Id">
                <div class="category-head">
                    <MudTextField T="string" Value="category.Name" ValueChanged="@(v => { category.Name = v; RubricChanged(); })" Immediate="true"
                                  Variant="Variant.Text" Class="flex-grow-1 category-name" Placeholder="@T("Kategorie")" />
                    <MudIconButton Icon="@Icons.Material.Outlined.ArrowUpward" Size="Size.Small" Disabled="@(categories.IndexOf(category) == 0)"
                                   OnClick="() => Move(categories, category, -1)" aria-label="@T("Kategorie nach oben")" />
                    <MudIconButton Icon="@Icons.Material.Outlined.ArrowDownward" Size="Size.Small" Disabled="@(categories.IndexOf(category) == categories.Count - 1)"
                                   OnClick="() => Move(categories, category, 1)" aria-label="@T("Kategorie nach unten")" />
                    <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small"
                                   OnClick="() => { categories.Remove(category); RubricChanged(); }" aria-label="@T("Kategorie löschen")" />
                </div>
                @foreach (var criterion in category.Criteria)
                {
                    var teacher = criterion.AssessedBy == AssessedBy.Teacher;
                    <div class="@($"criterion {(teacher ? "teacher" : "")}")" @key="criterion.Id">
                        <MudTextField T="string" Value="criterion.Text" ValueChanged="@(v => { criterion.Text = v; RubricChanged(); })" Immediate="true"
                                      Variant="Variant.Text" Lines="1" Sizing="InputSizing.Auto" MaxLines="6" Placeholder="@T("Kriterium")" Underline="false" />
                        <div class="d-flex">
                            <MudIconButton Icon="@Icons.Material.Outlined.KeyboardArrowUp" Size="Size.Small" Disabled="@(category.Criteria.IndexOf(criterion) == 0)"
                                           OnClick="() => Move(category.Criteria, criterion, -1)" aria-label="@T("Nach oben")" />
                            <MudIconButton Icon="@Icons.Material.Outlined.KeyboardArrowDown" Size="Size.Small" Disabled="@(category.Criteria.IndexOf(criterion) == category.Criteria.Count - 1)"
                                           OnClick="() => Move(category.Criteria, criterion, 1)" aria-label="@T("Nach unten")" />
                        </div>
                        <div class="criterion-tools">
                            <span class="seg" role="radiogroup" aria-label="@T("Wer beurteilt")">
                                <button type="button" class="@(teacher ? "" : "on")" @onclick="() => SetAssessor(criterion, AssessedBy.Ai)">@T("KI schlägt vor")</button>
                                <button type="button" class="@(teacher ? "on teacher" : "")" @onclick="() => SetAssessor(criterion, AssessedBy.Teacher)">@T("nur Lehrperson")</button>
                            </span>
                            <span class="weight" title="@T("Gewicht")">
                                @T("Gewicht")
                                <button type="button" @onclick="() => ChangeWeight(criterion, -0.5m)" aria-label="@T("Gewicht verringern")">−</button>
                                <b>@criterion.Weight.ToString("0.#")×</b>
                                <button type="button" @onclick="() => ChangeWeight(criterion, 0.5m)" aria-label="@T("Gewicht erhöhen")">+</button>
                            </span>
                            <span class="topbar-spacer"></span>
                            <MudIconButton Icon="@Icons.Material.Outlined.Close" Size="Size.Small" aria-label="@T("Kriterium entfernen")"
                                           OnClick="() => { category.Criteria.Remove(criterion); RubricChanged(); }" />
                        </div>
                    </div>
                }
                <MudButton Class="btn-quiet mt-2" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Add" OnClick="() => AddCriterion(category)">@T("Kriterium")</MudButton>
            </div>
        }

        <MudButton Class="btn-soft mt-5" StartIcon="@Icons.Material.Outlined.PlaylistAdd" OnClick="AddCategory">@T("Kategorie")</MudButton>
    </section>

    <div class="next-step">
        @if (!HasCriteria)
        {
            <span class="muted">@T("Fotos kannst du schon jetzt erfassen. Für die Bewertung braucht es Kriterien.")</span>
        }
        <MudButton Class="btn-ink" Size="Size.Large" OnClick="GoNextAsync" EndIcon="@Icons.Material.Filled.ArrowForward">
            @T("Weiter zu Arbeiten erfassen")
        </MudButton>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Exam Exam { get; set; } = null!;
    [Parameter] public EventCallback Changed { get; set; }
    [Parameter] public EventCallback Next { get; set; }

    private readonly Debouncer rubricSaver = new();
    private Exam grading = new();
    private List<RubricCategory> categories = [];
    private bool importing;
    private Guid loadedFor;

    private bool HasCriteria => categories.Any(c => c.Criteria.Any(k => !string.IsNullOrWhiteSpace(k.Text)));

    protected override void OnParametersSet()
    {
        // Only load when another exam is shown. Afterwards this panel owns the rubric and grading
        // values, so an auto-save that reloads the exam does not drop an empty, just added criterion.
        if (loadedFor == Exam.Id)
        {
            return;
        }
        loadedFor = Exam.Id;
        grading = new Exam { Id = Exam.Id, LocalOnly = Exam.LocalOnly };
        categories = CopyOf(Exam.Categories);
    }

    private static List<RubricCategory> CopyOf(IEnumerable<RubricCategory> source) =>
        source.Select(c => new RubricCategory
            {
                Id = c.Id,
                ExamId = c.ExamId,
                Name = c.Name,
                Order = c.Order,
                Criteria = c.Criteria.Select(k => new RubricCriterion
                {
                    Id = k.Id,
                    CategoryId = k.CategoryId,
                    Text = k.Text,
                    Weight = k.Weight,
                    AssessedBy = k.AssessedBy,
                    Order = k.Order,
                }).ToList(),
            })
            .ToList();

    private void SetAssessor(RubricCriterion criterion, AssessedBy assessedBy)
    {
        criterion.AssessedBy = assessedBy;
        RubricChanged();
    }

    private void ChangeWeight(RubricCriterion criterion, decimal delta)
    {
        criterion.Weight = Math.Clamp(criterion.Weight + delta, 0m, 5m);
        RubricChanged();
    }

    private void RubricChanged() => rubricSaver.Schedule(() => InvokeAsync(SaveRubricAsync));

    private async Task SaveRubricAsync()
    {
        // Empty criteria and categories stay on screen while being filled in, but are not saved.
        var complete = CopyOf(categories);
        foreach (var category in complete)
        {
            category.Criteria.RemoveAll(k => string.IsNullOrWhiteSpace(k.Text));
        }
        complete.RemoveAll(c => c.Criteria.Count == 0);
        await Repository.SaveRubricAsync(Exam.Id, complete);
        await Changed.InvokeAsync();
    }

    private async Task SetLocalOnlyAsync(bool value)
    {
        grading.LocalOnly = value;
        await Repository.SetLocalOnlyAsync(Exam.Id, value);
        await Changed.InvokeAsync();
        Snackbar.Add(value ? T("Diese Prüfung wird nur noch lokal bewertet.") : T("Diese Prüfung darf wieder mit Claude bewertet werden."), Severity.Success);
    }

    private async Task GoNextAsync()
    {
        await rubricSaver.FlushAsync();
        await Next.InvokeAsync();
    }

    private bool HasRubricSource => !string.IsNullOrWhiteSpace(Exam.RubricText) || Exam.PagesOf(DocumentKind.Beurteilung).Any();

    private Task OnDocumentChanged() => Changed.InvokeAsync();

    private async Task ImportRubricAsync()
    {
        if (!Settings.CanGrade(grading))
        {
            Snackbar.Add(grading.LocalOnly
                ? RoutingModelGateway.LocalOnlyWithoutModel
                : T("Bitte zuerst unter «Einstellungen» Claude oder ein lokales Modell einrichten."), Severity.Warning);
            return;
        }
        if (categories.Count > 0 || Exam.Submissions.Any(s => s.GradedAt is not null))
        {
            var confirmed = await Dialogs.ShowMessageBoxAsync(
                T("Kriterien ersetzen?"),
                T("Die bisherigen Kriterien werden durch die ausgelesenen ersetzt. Bereits bewertete Arbeiten müssen danach neu bewertet werden."),
                yesText: T("Ersetzen"),
                cancelText: T("Abbrechen"));
            if (confirmed != true)
            {
                return;
            }
        }

        await rubricSaver.FlushAsync();
        importing = true;
        StateHasChanged();
        try
        {
            var pages = new List<byte[]>();
            foreach (var page in Exam.PagesOf(DocumentKind.Beurteilung))
            {
                pages.Add(ImageCover.Apply(await Files.ReadAsync(page.RelativePath), page.Covers, page.Crop));
            }
            var imported = await RubricImport.ImportAsync(Exam.RubricText, pages, Exam.ExerciseText, grading.LocalOnly, CancellationToken.None);
            await Repository.SaveRubricAsync(Exam.Id, imported);
            categories = CopyOf(imported);
            var teacherOnly = categories.SelectMany(c => c.Criteria).Count(k => k.AssessedBy == AssessedBy.Teacher);
            var total = categories.Sum(c => c.Criteria.Count);
            Snackbar.Add(
                teacherOnly > 0
                    ? T("{0} Kriterien übernommen, davon {1} nur für die Lehrperson. Bitte kurz prüfen.", total, teacherOnly)
                    : T("{0} Kriterien übernommen. Bitte kurz prüfen.", total),
                Severity.Success);
            await Changed.InvokeAsync();
        }
        catch (ModelException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            importing = false;
        }
    }

    private void AddCategory()
    {
        var category = new RubricCategory { ExamId = Exam.Id, Name = T("Neue Kategorie") };
        AddCriterion(category);
        categories.Add(category);
    }

    private void AddCriterion(RubricCategory category)
    {
        // An empty criterion is not saved until it has text, so there is nothing to save yet.
        category.Criteria.Add(new RubricCriterion { CategoryId = category.Id });
    }

    private void Move<T>(List<T> list, T item, int delta)
    {
        var index = list.IndexOf(item);
        var target = index + delta;
        if (target < 0 || target >= list.Count)
        {
            return;
        }
        list.RemoveAt(index);
        list.Insert(target, item);
        RubricChanged();
    }

    public async ValueTask DisposeAsync()
    {
        await rubricSaver.DisposeAsync();
    }
}
