@using ArtGrader.Core.Ai
@using ArtGrader.Core.Images
@inject ExamRepository Repository
@inject FileStore Files
@inject RubricImportService RubricImport
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject SettingsStore Settings
@implements IAsyncDisposable

<div class="flow">
    <section class="sheet">
        <h2 class="sheet-title">Datenschutz</h2>
        <div class="@($"privacy-choice {(grading.LocalOnly ? "on" : "")}")">
            <MudSwitch T="bool" Value="grading.LocalOnly" ValueChanged="SetLocalOnlyAsync" Color="Color.Success" Label="Nur lokal bewerten" />
            <p>
                @if (grading.LocalOnly)
                {
                    <text>Dokumente, Fotos und Kriterien dieser Prüfung gehen nie ins Internet. Bewertet wird mit dem lokalen Modell@(string.IsNullOrWhiteSpace(Settings.OllamaModel) ? "" : $" «{Settings.OllamaModel}»").</text>
                }
                else
                {
                    <text>Einschalten, wenn für diese Prüfung nichts in die Cloud gehen darf. Das lokale Modell ist langsamer und etwas weniger genau.</text>
                }
            </p>
            @if (grading.LocalOnly && string.IsNullOrWhiteSpace(Settings.OllamaModel))
            {
                <div class="banner mt-2">Es ist noch kein lokales Modell eingerichtet. <a href="/einstellungen">Zu den Einstellungen</a></div>
            }
        </div>
    </section>

    <DocumentSection Exam="Exam" Kind="DocumentKind.Aufgabe" Title="Aufgabenstellung"
                     Sub="Das Blatt, das die Klasse bekommen hat. Die KI liest es, um zu verstehen, worum es geht."
                     DropText="Word, PDF oder Text hierher ziehen" TextLabel="Text der Aufgabe"
                     Placeholder="Aufgabe hochladen oder hier eintippen" Changed="OnDocumentChanged" />

    <DocumentSection Exam="Exam" Kind="DocumentKind.Unterricht" Title="Unterrichtsmaterial" Optional="true"
                     Sub="Zum Beispiel die PowerPoint-Präsentation zum Thema. So weiss die KI, was im Unterricht behandelt wurde."
                     DropText="PowerPoint, PDF oder Word hierher ziehen" TextLabel="Text aus dem Unterrichtsmaterial" Rows="8"
                     Changed="OnDocumentChanged" />

    <DocumentSection Exam="Exam" Kind="DocumentKind.Beurteilung" Title="Beurteilungsbogen"
                     Sub="Hochladen, prüfen und schwärzen. Dann liest die KI die Kriterien daraus aus."
                     DropText="Beurteilungsbogen hierher ziehen" TextLabel="Text des Beurteilungsbogens" Changed="OnDocumentChanged">
        <Footer>
            <MudButton Class="btn-ink" StartIcon="@Icons.Material.Filled.AutoAwesome" Disabled="@(importing || !HasRubricSource)" OnClick="ImportRubricAsync">
                @(importing ? "Die KI liest …" : "Kriterien auslesen")
            </MudButton>
        </Footer>
    </DocumentSection>

    <section class="sheet">
        <h2 class="sheet-title">Beurteilungskriterien</h2>
        <p class="sheet-sub">Aus dem Beurteilungsbogen auslesen oder selbst erfassen. Danach kannst du alles anpassen.</p>

        @if (categories.Count == 0)
        {
            <p class="faint mt-4">Noch keine Kriterien.</p>
        }

        @foreach (var category in categories)
        {
            <div class="category" @key="category.Id">
                <div class="category-head">
                    <MudTextField T="string" Value="category.Name" ValueChanged="@(v => { category.Name = v; RubricChanged(); })" Immediate="true"
                                  Variant="Variant.Text" Class="flex-grow-1 category-name" Placeholder="Kategorie" />
                    <MudIconButton Icon="@Icons.Material.Outlined.ArrowUpward" Size="Size.Small" Disabled="@(categories.IndexOf(category) == 0)"
                                   OnClick="() => Move(categories, category, -1)" aria-label="Kategorie nach oben" />
                    <MudIconButton Icon="@Icons.Material.Outlined.ArrowDownward" Size="Size.Small" Disabled="@(categories.IndexOf(category) == categories.Count - 1)"
                                   OnClick="() => Move(categories, category, 1)" aria-label="Kategorie nach unten" />
                    <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small"
                                   OnClick="() => { categories.Remove(category); RubricChanged(); }" aria-label="Kategorie löschen" />
                </div>
                @foreach (var criterion in category.Criteria)
                {
                    var teacher = criterion.AssessedBy == AssessedBy.Teacher;
                    <div class="@($"criterion {(teacher ? "teacher" : "")}")" @key="criterion.Id">
                        <MudTextField T="string" Value="criterion.Text" ValueChanged="@(v => { criterion.Text = v; RubricChanged(); })" Immediate="true"
                                      Variant="Variant.Text" Lines="1" Sizing="InputSizing.Auto" MaxLines="6" Placeholder="Kriterium" Underline="false" />
                        <div class="d-flex">
                            <MudIconButton Icon="@Icons.Material.Outlined.KeyboardArrowUp" Size="Size.Small" Disabled="@(category.Criteria.IndexOf(criterion) == 0)"
                                           OnClick="() => Move(category.Criteria, criterion, -1)" aria-label="Nach oben" />
                            <MudIconButton Icon="@Icons.Material.Outlined.KeyboardArrowDown" Size="Size.Small" Disabled="@(category.Criteria.IndexOf(criterion) == category.Criteria.Count - 1)"
                                           OnClick="() => Move(category.Criteria, criterion, 1)" aria-label="Nach unten" />
                        </div>
                        <div class="criterion-tools">
                            <span class="seg" role="radiogroup" aria-label="Wer beurteilt">
                                <button type="button" class="@(teacher ? "" : "on")" @onclick="() => SetAssessor(criterion, AssessedBy.Ai)">KI schlägt vor</button>
                                <button type="button" class="@(teacher ? "on teacher" : "")" @onclick="() => SetAssessor(criterion, AssessedBy.Teacher)">nur Lehrperson</button>
                            </span>
                            <span class="weight" title="Gewicht">
                                Gewicht
                                <button type="button" @onclick="() => ChangeWeight(criterion, -0.5m)" aria-label="Gewicht verringern">−</button>
                                <b>@criterion.Weight.ToString("0.#")×</b>
                                <button type="button" @onclick="() => ChangeWeight(criterion, 0.5m)" aria-label="Gewicht erhöhen">+</button>
                            </span>
                            <span class="topbar-spacer"></span>
                            <MudIconButton Icon="@Icons.Material.Outlined.Close" Size="Size.Small" aria-label="Kriterium entfernen"
                                           OnClick="() => { category.Criteria.Remove(criterion); RubricChanged(); }" />
                        </div>
                    </div>
                }
                <MudButton Class="btn-quiet mt-2" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Add" OnClick="() => AddCriterion(category)">Kriterium</MudButton>
            </div>
        }

        <MudButton Class="btn-soft mt-5" StartIcon="@Icons.Material.Outlined.PlaylistAdd" OnClick="AddCategory">Kategorie</MudButton>
    </section>

    <section class="sheet">
        <h2 class="sheet-title">Notenberechnung</h2>
        <p class="sheet-sub">So wird aus den Stufen eine Note.</p>
        <div class="points-grid">
            <div class="point-swatch"><span class="sw" style="background:var(--level-3)"></span><MudNumericField @bind-Value="grading.Settings.PointsUebertroffen" @bind-Value:after="GradingChanged" Immediate="true" Label="Übertroffen" Variant="Variant.Text" Min="0" Max="10" /></div>
            <div class="point-swatch"><span class="sw" style="background:var(--level-2)"></span><MudNumericField @bind-Value="grading.Settings.PointsErfuellt" @bind-Value:after="GradingChanged" Immediate="true" Label="Erfüllt" Variant="Variant.Text" Min="0" Max="10" /></div>
            <div class="point-swatch"><span class="sw" style="background:var(--level-1)"></span><MudNumericField @bind-Value="grading.Settings.PointsTeilweise" @bind-Value:after="GradingChanged" Immediate="true" Label="Teilweise" Variant="Variant.Text" Min="0" Max="10" /></div>
            <div class="point-swatch"><span class="sw" style="background:var(--level-0)"></span><MudNumericField @bind-Value="grading.Settings.PointsNicht" @bind-Value:after="GradingChanged" Immediate="true" Label="Nicht erfüllt" Variant="Variant.Text" Min="0" Max="10" /></div>
        </div>
        <MudSelect T="decimal" @bind-Value="grading.Settings.RoundingStep" @bind-Value:after="GradingChanged" Label="Runden auf" Variant="Variant.Outlined" Class="mt-4">
            <MudSelectItem T="decimal" Value="0.5m">Halbe Noten (4.5)</MudSelectItem>
            <MudSelectItem T="decimal" Value="0.25m">Viertelnoten (4.25)</MudSelectItem>
            <MudSelectItem T="decimal" Value="0.1m">Zehntel (4.3)</MudSelectItem>
        </MudSelect>
        <div class="formula">Note = Punkte ÷ Maximum × 5 + 1 &nbsp;·&nbsp; <span class="muted" style="font-style:normal">@Example()</span></div>
    </section>

    <div class="next-step">
        @if (!HasCriteria)
        {
            <span class="muted">Sobald es Kriterien gibt, kannst du die Arbeiten erfassen.</span>
        }
        <MudButton Class="btn-ink" Size="Size.Large" Disabled="@(!HasCriteria)" OnClick="GoNextAsync" EndIcon="@Icons.Material.Filled.ArrowForward">
            Weiter zu den Arbeiten
        </MudButton>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Exam Exam { get; set; } = null!;
    [Parameter] public EventCallback Changed { get; set; }
    [Parameter] public EventCallback Next { get; set; }

    private readonly Debouncer rubricSaver = new();
    private readonly Debouncer gradingSaver = new();
    private Exam grading = new();
    private List<RubricCategory> categories = [];
    private bool importing;
    private Guid loadedFor;

    private bool HasCriteria => categories.Any(c => c.Criteria.Any(k => !string.IsNullOrWhiteSpace(k.Text)));

    protected override void OnParametersSet()
    {
        // Only load when another exam is shown. Afterwards this panel owns the rubric and grading
        // values, so an auto-save that reloads the exam does not drop an empty, just added criterion.
        if (loadedFor == Exam.Id)
        {
            return;
        }
        loadedFor = Exam.Id;
        grading = new Exam
        {
            Id = Exam.Id,
            LocalOnly = Exam.LocalOnly,
            Settings = new GradingSettings
            {
                PointsUebertroffen = Exam.Settings.PointsUebertroffen,
                PointsErfuellt = Exam.Settings.PointsErfuellt,
                PointsTeilweise = Exam.Settings.PointsTeilweise,
                PointsNicht = Exam.Settings.PointsNicht,
                RoundingStep = Exam.Settings.RoundingStep,
                MinGrade = Exam.Settings.MinGrade,
                MaxGrade = Exam.Settings.MaxGrade,
            },
        };
        categories = CopyOf(Exam.Categories);
    }

    private static List<RubricCategory> CopyOf(IEnumerable<RubricCategory> source) =>
        source.Select(c => new RubricCategory
            {
                Id = c.Id,
                ExamId = c.ExamId,
                Name = c.Name,
                Order = c.Order,
                Criteria = c.Criteria.Select(k => new RubricCriterion
                {
                    Id = k.Id,
                    CategoryId = k.CategoryId,
                    Text = k.Text,
                    Weight = k.Weight,
                    AssessedBy = k.AssessedBy,
                    Order = k.Order,
                }).ToList(),
            })
            .ToList();

    private string Example()
    {
        var count = Math.Max(1, categories.Sum(c => c.Criteria.Count(k => k.Weight > 0)));
        var max = count * grading.Settings.MaxLevelPoints;
        if (max == 0)
        {
            return "";
        }
        var points = count * grading.Settings.PointsErfuellt;
        var grade = GradeCalculator.ToGrade(points, max, grading.Settings);
        return $"alles «erfüllt» = {points}/{max} Punkte → {grade:0.0#}";
    }

    private void SetAssessor(RubricCriterion criterion, AssessedBy assessedBy)
    {
        criterion.AssessedBy = assessedBy;
        RubricChanged();
    }

    private void ChangeWeight(RubricCriterion criterion, decimal delta)
    {
        criterion.Weight = Math.Clamp(criterion.Weight + delta, 0m, 5m);
        RubricChanged();
    }

    private void RubricChanged() => rubricSaver.Schedule(() => InvokeAsync(SaveRubricAsync));

    private void GradingChanged() => gradingSaver.Schedule(() => InvokeAsync(SaveGradingAsync));

    private async Task SaveRubricAsync()
    {
        // Empty criteria and categories stay on screen while being filled in, but are not saved.
        var complete = CopyOf(categories);
        foreach (var category in complete)
        {
            category.Criteria.RemoveAll(k => string.IsNullOrWhiteSpace(k.Text));
        }
        complete.RemoveAll(c => c.Criteria.Count == 0);
        await Repository.SaveRubricAsync(Exam.Id, complete);
        await Changed.InvokeAsync();
    }

    private async Task SaveGradingAsync()
    {
        await Repository.UpdateGradingAsync(Exam.Id, grading.LocalOnly, grading.Settings);
        await Changed.InvokeAsync();
    }

    private async Task SetLocalOnlyAsync(bool value)
    {
        grading.LocalOnly = value;
        await gradingSaver.FlushAsync();
        await SaveGradingAsync();
        Snackbar.Add(value ? "Diese Prüfung wird nur noch lokal bewertet." : "Diese Prüfung darf wieder mit Claude bewertet werden.", Severity.Success);
    }

    private async Task GoNextAsync()
    {
        await rubricSaver.FlushAsync();
        await gradingSaver.FlushAsync();
        await Next.InvokeAsync();
    }

    private bool HasRubricSource => !string.IsNullOrWhiteSpace(Exam.RubricText) || Exam.PagesOf(DocumentKind.Beurteilung).Any();

    private Task OnDocumentChanged() => Changed.InvokeAsync();

    private async Task ImportRubricAsync()
    {
        if (!Settings.CanGrade(grading))
        {
            Snackbar.Add(grading.LocalOnly
                ? RoutingModelGateway.LocalOnlyWithoutModel
                : "Bitte zuerst unter «Einstellungen» Claude oder ein lokales Modell einrichten.", Severity.Warning);
            return;
        }
        if (categories.Count > 0 || Exam.Submissions.Any(s => s.GradedAt is not null))
        {
            var confirmed = await Dialogs.ShowMessageBoxAsync(
                "Kriterien ersetzen?",
                "Die bisherigen Kriterien werden durch die ausgelesenen ersetzt. Bereits bewertete Arbeiten müssen danach neu bewertet werden.",
                yesText: "Ersetzen",
                cancelText: "Abbrechen");
            if (confirmed != true)
            {
                return;
            }
        }

        await rubricSaver.FlushAsync();
        importing = true;
        StateHasChanged();
        try
        {
            var pages = new List<byte[]>();
            foreach (var page in Exam.PagesOf(DocumentKind.Beurteilung))
            {
                pages.Add(ImageCover.Apply(await Files.ReadAsync(page.RelativePath), page.Covers, page.Crop));
            }
            var imported = await RubricImport.ImportAsync(Exam.RubricText, pages, Exam.ExerciseText, grading.LocalOnly, CancellationToken.None);
            await Repository.SaveRubricAsync(Exam.Id, imported);
            categories = CopyOf(imported);
            var teacherOnly = categories.SelectMany(c => c.Criteria).Count(k => k.AssessedBy == AssessedBy.Teacher);
            Snackbar.Add(
                $"{categories.Sum(c => c.Criteria.Count)} Kriterien übernommen"
                    + (teacherOnly > 0 ? $", davon {teacherOnly} nur für die Lehrperson" : "") + ". Bitte kurz prüfen.",
                Severity.Success);
            await Changed.InvokeAsync();
        }
        catch (ModelException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            importing = false;
        }
    }

    private void AddCategory()
    {
        var category = new RubricCategory { ExamId = Exam.Id, Name = "Neue Kategorie" };
        AddCriterion(category);
        categories.Add(category);
    }

    private void AddCriterion(RubricCategory category)
    {
        // An empty criterion is not saved until it has text, so there is nothing to save yet.
        category.Criteria.Add(new RubricCriterion { CategoryId = category.Id });
    }

    private void Move<T>(List<T> list, T item, int delta)
    {
        var index = list.IndexOf(item);
        var target = index + delta;
        if (target < 0 || target >= list.Count)
        {
            return;
        }
        list.RemoveAt(index);
        list.Insert(target, item);
        RubricChanged();
    }

    public async ValueTask DisposeAsync()
    {
        await rubricSaver.DisposeAsync();
        await gradingSaver.DisposeAsync();
    }
}
