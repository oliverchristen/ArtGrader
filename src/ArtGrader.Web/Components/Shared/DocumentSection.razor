@using ArtGrader.Core.Documents
@inject ExamRepository Repository
@inject FileStore Files
@inject ISnackbar Snackbar
@inject SettingsStore Settings
@inject ArtGrader.Core.Ai.LocalRedactionFinder RedactionFinder

<section class="sheet">
    <div class="d-flex align-center justify-space-between gap-2">
        <h2 class="sheet-title">@Title</h2>
        @if (Optional)
        {
            <span class="tag">@T("optional")</span>
        }
    </div>
    <p class="sheet-sub">@Sub</p>

    <div class="dropzone compact mb-3">
        <InputFile OnChange="UploadAsync" accept="@Accept" aria-label="@T("Upload {0}", Title)" disabled="@busy" />
        @if (busy)
        {
            <span class="file-chip"><MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Tertiary" /> @T("Reading file …")</span>
        }
        else
        {
            <span class="file-chip">
                <span class="doc">@DocType(File)</span>
                @if (File is null)
                {
                    <span>@(DropText ?? T("Drag a file here")) <span class="faint">@T("or click")</span></span>
                }
                else
                {
                    <span>@File.OriginalName <span class="faint">· @T("replace")</span></span>
                }
            </span>
        }
    </div>

    @if (File is not null || pages.Count > 0 || !string.IsNullOrWhiteSpace(Text))
    {
        <div class="redact-hint">
            <MudIcon Icon="@Icons.Material.Outlined.VisibilityOff" Size="Size.Small" />
            <span>
                <b>@T("The AI reads this.")</b> @T("Redact anything that points to your school: school name, logo, address, names of teachers or classes. The AI does not need this for the assessment.")
            </span>
        </div>
    }

    @if (pages.Count > 0)
    {
        <div class="doc-pages">
            @foreach (var page in pages)
            {
                <div class="doc-page" @key="page.Id">
                    <div class="doc-page-label">@T("Page {0} of {1}", page.Order + 1, pages.Count)</div>
                    <CoverEditor Src="@ImageUrls.Original(page)" Covers="page.Covers" Crop="page.Crop" ItemId="page.Id"
                                 CoverLabel="@T("Redact an area")" FrameClass="page-frame" Alt="@T("{0}, page {1}", Title, page.Order + 1)"
                                 Save="edits => SavePageAsync(page, edits)" />
                </div>
            }
        </div>
    }
    else
    {
        <RedactableText Value="@Text" ValueChanged="SaveTextAsync" Label="@(TextLabel ?? T("Text"))" Rows="@Rows" Placeholder="@Placeholder"
                        Terms="Settings.RedactTerms" CheckWithModel="@(localModel is null ? null : CheckWithModelAsync)" />
    }

    <div class="d-flex justify-space-between align-center flex-wrap gap-2 mt-3">
        @if (File is not null || pages.Count > 0)
        {
            <MudButton Class="btn-quiet" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Delete" OnClick="RemoveAsync">@T("Remove document")</MudButton>
        }
        else
        {
            <span></span>
        }
        @Footer
    </div>
</section>

@code {
    private const long MaxDocumentBytes = 40 * 1024 * 1024;

    [Parameter, EditorRequired] public Exam Exam { get; set; } = null!;
    [Parameter, EditorRequired] public DocumentKind Kind { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string Sub { get; set; } = "";
    [Parameter] public string? DropText { get; set; }
    [Parameter] public string Accept { get; set; } = ".docx,.pptx,.pdf,.txt,.md";
    [Parameter] public string? TextLabel { get; set; }
    [Parameter] public string Placeholder { get; set; } = "";
    [Parameter] public int Rows { get; set; } = 10;
    [Parameter] public bool Optional { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }
    [Parameter] public EventCallback Changed { get; set; }

    private List<DocumentPage> pages = [];
    private bool busy;

    private StoredFile? File => Kind switch
    {
        DocumentKind.Aufgabe => Exam.ExerciseFile,
        DocumentKind.Beurteilung => Exam.RubricFile,
        _ => Exam.LessonFile,
    };

    private string Text => Kind switch
    {
        DocumentKind.Aufgabe => Exam.ExerciseText,
        DocumentKind.Beurteilung => Exam.RubricText,
        _ => Exam.LessonText,
    };

    private string? localModel;

    protected override void OnParametersSet() => pages = Exam.PagesOf(Kind).ToList();

    protected override async Task OnInitializedAsync() => localModel = await RedactionFinder.AvailableModelAsync(CancellationToken.None);

    private static string DocType(StoredFile? file) =>
        file is null ? "+" : Path.GetExtension(file.OriginalName).TrimStart('.').ToUpperInvariant();

    private async Task UploadAsync(InputFileChangeEventArgs e)
    {
        if (e.File.Size > MaxDocumentBytes)
        {
            Snackbar.Add(T("The file is larger than 40 MB."), Severity.Error);
            return;
        }
        busy = true;
        try
        {
            using var stream = new MemoryStream();
            await e.File.OpenReadStream(MaxDocumentBytes).CopyToAsync(stream);
            var bytes = stream.ToArray();
            var content = await Task.Run(() => DocumentContent.Read(e.File.Name, bytes));
            var file = new StoredFile
            {
                OriginalName = e.File.Name,
                RelativePath = await Files.SaveDocumentAsync(Exam.Id, Kind.ToString().ToLowerInvariant(), e.File.Name, bytes),
                ContentType = content.Pages.Count > 0 ? "application/pdf" : "text/plain",
            };
            var paths = new List<string>();
            foreach (var page in content.Pages)
            {
                paths.Add(await Files.SavePageAsync(Exam.Id, page));
            }
            var previous = File?.RelativePath;
            foreach (var old in await Repository.SetDocumentAsync(Exam.Id, Kind, file, content.Text, paths))
            {
                Files.Delete(old);
            }
            Files.Delete(previous);
            Snackbar.Add(content.Pages.Count > 0
                ? T("{0} page(s) added. Please check them and redact anything that points to the school.", content.Pages.Count)
                : T("Text added. Please check it and redact anything that points to the school."), Severity.Success);
            await Changed.InvokeAsync();
        }
        catch (UnsupportedDocumentException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception ex) when (ex is DocumentFormat.OpenXml.Packaging.OpenXmlPackageException or InvalidDataException or FileFormatException)
        {
            Snackbar.Add(T("The file could not be read."), Severity.Error);
        }
        finally
        {
            busy = false;
        }
    }

    private Task<IReadOnlyList<(string Text, string Reason)>> CheckWithModelAsync(string text) =>
        RedactionFinder.FindAsync(text, CancellationToken.None);

    private async Task SaveTextAsync(string text)
    {
        await Repository.SetDocumentTextAsync(Exam.Id, Kind, text);
        await Changed.InvokeAsync();
    }

    private async Task SavePageAsync(DocumentPage page, ImageEdits edits)
    {
        await Repository.SetPageEditsAsync(page.Id, edits.Covers, edits.Crop);
        page.Covers = edits.Covers;
        page.Crop = edits.Crop;
    }

    private async Task RemoveAsync()
    {
        var previous = File?.RelativePath;
        foreach (var old in await Repository.SetDocumentAsync(Exam.Id, Kind, null, "", []))
        {
            Files.Delete(old);
        }
        Files.Delete(previous);
        await Changed.InvokeAsync();
    }
}
