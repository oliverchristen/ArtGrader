@if (Exam.Submissions.Count == 0)
{
    <div class="sheet empty-state">
        <img src="@Assets["favicon.svg"]" alt="" />
        <p class="muted mt-3">@T("No works yet.")</p>
    </div>
    return;
}

<ModelMixWarning Exam="Exam" Class="mb-4" />

<section class="sheet">
    <h2 class="sheet-title">@T("Results")</h2>
<div class="stats stats-inline">
    <div class="stat">
        <div class="k">@T("Average")</div>
        <div class="v">@(average?.ToString("0.00") ?? "–")</div>
        <div class="faint" style="font-size:.8rem">@(provisionalOnly ? T("provisional") : T("{0} final grades", finalCount))</div>
    </div>
    <div class="stat">
        <div class="k">@T("Range")</div>
        <div class="v">@(min is null ? "–" : $"{min:0.0#} – {max:0.0#}")</div>
    </div>
    <div class="stat">
        <div class="k">@T("Completed")</div>
        <div class="v">@Exam.Submissions.Count(s => s.Status == SubmissionStatus.Abgeschlossen)<span class="faint" style="font-size:1rem"> / @Exam.Submissions.Count</span></div>
    </div>
    <div class="stat">
        <div class="k">@T("Distribution")</div>
        <div class="histogram" aria-label="@T("Grade distribution")">
            @foreach (var (grade, count) in histogram)
            {
                <div title="@T("{0}× grade {1}", count, grade)">
                    <i style="@($"height:{(histogramMax == 0 ? 0 : 100 * count / histogramMax)}%")"></i>
                    <span>@grade</span>
                </div>
            }
        </div>
    </div>
</div>

</section>

<section class="sheet">
    <h2 class="sheet-title mb-4">@T("Grade list")</h2>
    <div class="table-wrap">
        <table class="grades">
            <thead>
                <tr>
                    <th>@T("Name")</th>
                    @foreach (var (criterion, number) in criteria.Select((c, i) => (c, i + 1)))
                    {
                        <th title="@criterion.Text">@T("C{0}", number)@(criterion.AssessedBy == AssessedBy.Teacher ? "*" : "")</th>
                    }
                    <th>@T("Points")</th>
                    <th>@T("Grade")</th>
                    <th>@T("Status")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var submission in Exam.Submissions)
                {
                    var result = GradeCalculator.Calculate(Exam, submission);
                    var grade = GradeCalculator.FinalGrade(Exam, submission);
                    <tr>
                        <td class="name"><a href="@($"/pruefung/{Exam.Id}/arbeit/{submission.Id}")">@submission.StudentName</a></td>
                        @foreach (var criterion in criteria)
                        {
                            var level = submission.Assessments.FirstOrDefault(a => a.CriterionId == criterion.Id)?.EffectiveLevel;
                            <td>
                                @if (level is not null)
                                {
                                    <span class="@($"lv-dot lv-{(int)level.Value}")" title="@LevelText.Label(level.Value)"></span>
                                }
                                else
                                {
                                    <span class="lv-dot none" title="@T("open")"></span>
                                }
                            </td>
                        }
                        <td class="muted">@result.Points.ToString("0.##") / @result.MaxPoints.ToString("0.##")</td>
                        <td class="grade-cell">
                            @if (grade is not null)
                            {
                                @grade.Value.ToString("0.0#")@(submission.FinalGradeOverride is not null ? " ✎" : "")
                            }
                            else if (result.Provisional is not null)
                            {
                                <span class="faint" title="@T("provisional")">≈ @result.Provisional.Value.ToString("0.0#")</span>
                            }
                            else
                            {
                                <span class="faint">–</span>
                            }
                        </td>
                        <td><span class="@($"status s-{submission.Status}")"><span class="dot"></span>@LevelText.Label(submission.Status)</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="legend">
        @foreach (var level in LevelText.AllDescending)
        {
            <span><i class="@($"lv-dot lv-{(int)level}")"></i>@LevelText.Label(level)</span>
        }
        <span><i class="lv-dot none"></i>@T("open")</span>
        <span>✎ @T("grade set by you")</span>
        <span>≈ @T("provisional")</span>
    </div>
</section>

<section class="sheet">
    <h2 class="sheet-title">@T("Criteria")</h2>
    @foreach (var (criterion, number) in criteria.Select((c, i) => (c, i + 1)))
    {
        <div class="muted" style="font-size:.92rem;margin-top:6px">
            <b style="color:var(--ink)">@T("C{0}", number)</b> @criterion.Text
            @if (criterion.AssessedBy == AssessedBy.Teacher)
            {
                <span class="tag teacher ml-1">@T("Teacher")</span>
            }
        </div>
    }
</section>

<section class="sheet export-step">
    <h2 class="sheet-title">@T("Export")</h2>
    <p class="sheet-sub">@T("The grade list for your records and the assessment sheets for the class. Both stay on this computer.")</p>
    @if (Exam.Submissions.Any(s => s.Status != SubmissionStatus.Abgeschlossen))
    {
        <p class="muted mb-3">@T("Not all works are completed yet. Open works appear with a provisional grade.")</p>
    }
    <MudSwitch @bind-Value="withJustifications" Color="Color.Primary" Label="@T("Include the AI's justifications in the assessment sheets")" />
    <p class="faint" style="font-size:.85rem">
        @T("Always on the assessment sheet: photo, levels, grade and your feedback. If you have not written any, the AI's feedback is shown instead. Justifications only appear for criteria where you accepted the AI's level.")
    </p>
    <div class="next-step">
        <MudButton Class="btn-soft" Size="Size.Large" StartIcon="@Icons.Material.Outlined.GridOn" Href="@($"/export/{Exam.Id}/noten.xlsx")" Target="_blank">@T("Grade list (Excel)")</MudButton>
        <MudButton Class="btn-ink" Size="Size.Large" StartIcon="@Icons.Material.Outlined.PictureAsPdf" Target="_blank"
                   Href="@($"/export/{Exam.Id}/beurteilungen.pdf?begruendungen={withJustifications.ToString().ToLowerInvariant()}")">
            @T("Assessment sheets (PDF)")
        </MudButton>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public Exam Exam { get; set; } = null!;

    private List<RubricCriterion> criteria = [];
    private bool withJustifications;
    private decimal? average;
    private decimal? min;
    private decimal? max;
    private int finalCount;
    private bool provisionalOnly;
    private List<(string Grade, int Count)> histogram = [];
    private int histogramMax;

    protected override void OnParametersSet()
    {
        criteria = Exam.OrderedCriteria().ToList();
        var finals = Exam.Submissions.Select(s => GradeCalculator.FinalGrade(Exam, s)).OfType<decimal>().ToList();
        finalCount = finals.Count;
        var shown = finals.Count > 0
            ? finals
            : Exam.Submissions.Select(s => GradeCalculator.Calculate(Exam, s).Provisional).OfType<decimal>().ToList();
        provisionalOnly = finals.Count == 0 && shown.Count > 0;
        average = shown.Count == 0 ? null : shown.Average();
        min = shown.Count == 0 ? null : shown.Min();
        max = shown.Count == 0 ? null : shown.Max();
        histogram = Enumerable.Range(1, 6)
            .Select(g => (g.ToString(), shown.Count(x => Math.Round(x, MidpointRounding.AwayFromZero) == g)))
            .ToList();
        histogramMax = histogram.Count == 0 ? 0 : histogram.Max(h => h.Count);
    }
}
