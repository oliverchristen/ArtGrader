@using ArtGrader.Core.Ai
@using ArtGrader.Core.Images
@inject ExamRepository Repository
@inject FileStore Files
@inject GradingQueue Queue
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject SettingsStore Settings

@if (!Grading)
{
    @* Step 2: capture the works. Everything here happens before the AI sees anything. *@
    <div class="dropzone">
        <InputFile OnChange="UploadAsync" multiple accept="@accept" disabled="@uploading" aria-label="@T("Fotos hochladen")" />
        @if (uploading)
        {
            <div class="dz-title">@T("Fotos werden vorbereitet …")</div>
            <div class="d-flex align-center gap-3 justify-center" style="max-width:420px;margin:12px auto 0">
                <div class="brush-progress"><span style="@($"width:{(uploadTotal == 0 ? 0 : 100 * uploadDone / uploadTotal)}%")"></span></div>
                <span class="muted">@uploadDone / @uploadTotal</span>
            </div>
        }
        else
        {
            <span class="dz-icon"><MudIcon Icon="@Icons.Material.Outlined.AddPhotoAlternate" Size="Size.Large" /></span>
            <div class="dz-title">@T("Fotos der Arbeiten hierher legen")</div>
            <div class="muted">
                @(oneSubmission ? T("Alle Fotos werden zu einer Arbeit zusammengefasst.") : T("Jedes Foto wird eine Arbeit – mehrere Fotos einer Arbeit danach zusammenführen."))
            </div>
        }
    </div>
    <MudSwitch @bind-Value="oneSubmission" Color="Color.Primary" Label="@T("Alle Fotos dieses Uploads gehören zu einer Arbeit")" Class="mt-1" />

    @if (Exam.Submissions.Count > 0)
    {
        <div class="banner info mb-4">
            <MudIcon Icon="@Icons.Material.Outlined.VisibilityOff" />
            <span>
                @(T("Bereite die Arbeiten vor, bevor die KI sie sieht: Namen eintragen und Fotos derselben Arbeit zusammenführen.") + " "
                    + (Exam.LocalOnly
                        ? T("Steht ein Name oder eine Signatur auf dem Werk, öffne die Arbeit und decke die Stelle ab.")
                        : T("Steht ein Name oder eine Signatur auf dem Werk, öffne die Arbeit und decke die Stelle ab, sonst sieht die KI sie.")))
            </span>
        </div>

        <div class="toolbar">
            @if (selected.Count > 0)
            {
                <MudButton Class="btn-soft" StartIcon="@Icons.Material.Outlined.CallMerge" Disabled="@(selected.Count < 2)" OnClick="MergeAsync">
                    @T("Zusammenführen")
                </MudButton>
                <MudButton Class="btn-quiet" Color="Color.Secondary" StartIcon="@Icons.Material.Outlined.Delete" OnClick="DeleteSelectedAsync">@T("Löschen")</MudButton>
                <MudButton Class="btn-quiet" OnClick="() => selected.Clear()">@T("Auswahl aufheben ({0})", selected.Count)</MudButton>
            }
            else
            {
                <span class="muted" style="font-size:.9rem">@T("Zum Zusammenführen oder Löschen Arbeiten oben links anwählen.")</span>
            }
            <span class="topbar-spacer"></span>
            <span class="muted" style="font-size:.9rem">@T("{0} Arbeiten · {1} Fotos", Exam.Submissions.Count, Exam.Submissions.Sum(s => s.Images.Count))</span>
        </div>

        <div class="@($"wall {(selected.Count > 0 ? "selecting" : "")}")">
            @foreach (var submission in Exam.Submissions)
            {
                var isSelected = selected.Contains(submission.Id);
                <div class="@($"work {(isSelected ? "selected" : "")}")" @key="submission.Id">
                    <button type="button" class="work-select" aria-pressed="@(isSelected ? "true" : "false")" aria-label="@T("Auswählen")" @onclick="() => Toggle(submission.Id)">
                        @if (isSelected)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                        }
                    </button>
                    <a class="work-photo" href="@EditUrl(submission)" title="@T("Öffnen: abdecken, zuschneiden, Fotos abtrennen")">
                        <WorkPhoto Submission="submission" />
                    </a>
                    <WorkName Submission="submission" Renamed="OnRenamed" />
                </div>
            }
        </div>
    }

    <div class="next-step">
        @if (Exam.Submissions.Count == 0)
        {
            <span class="muted">@T("Lege oben die Fotos der Arbeiten ab.")</span>
        }
        <MudButton Class="btn-ink" Size="Size.Large" Disabled="@(Exam.Submissions.Count == 0)" OnClick="() => Next.InvokeAsync()" EndIcon="@Icons.Material.Filled.ArrowForward">
            @T("Weiter zum Bewerten")
        </MudButton>
    </div>
}
else
{
    @* Step 3: let the AI assess the captured works, then check each one. *@
    @if (Exam.Categories.Count == 0)
    {
        <div class="banner mb-4">
            <MudIcon Icon="@Icons.Material.Outlined.Info" />
            <span>@T("Lege zuerst die Beurteilungskriterien fest.") <a href="javascript:void(0)" @onclick="() => ShowStep.InvokeAsync(0)">@T("Zu Schritt 1")</a></span>
        </div>
    }
    else if (!Settings.CanGrade(Exam))
    {
        <div class="banner mb-4">
            <MudIcon Icon="@Icons.Material.Outlined.Lightbulb" />
            <span>
                @(Exam.LocalOnly ? RoutingModelGateway.LocalOnlyWithoutModel : T("Bevor die KI mitlesen kann, wähle Claude oder ein lokales Modell."))
                <a href="/einstellungen">@T("Zu den Einstellungen")</a>
            </span>
        </div>
    }

    @if (Exam.Submissions.Count == 0)
    {
        <div class="banner mb-4">
            <MudIcon Icon="@Icons.Material.Outlined.Info" />
            <span>@T("Noch keine Arbeiten.") <a href="javascript:void(0)" @onclick="() => ShowStep.InvokeAsync(1)">@T("Zu Schritt 2")</a></span>
        </div>
    }
    else
    {
        <div class="toolbar">
            <MudButton Class="btn-ink" StartIcon="@Icons.Material.Filled.AutoAwesome" Disabled="@(ungraded.Count == 0 || !CanGrade)"
                       OnClick="() => GradeAsync(ungraded)">
                @(ungraded.Count == 0 ? T("Alle bewertet") : T("{0} Arbeiten bewerten", ungraded.Count))
            </MudButton>
            @if (selected.Count > 0)
            {
                <MudButton Class="btn-soft" StartIcon="@Icons.Material.Outlined.Refresh" Disabled="@(!CanGrade)" OnClick="GradeSelectedAsync">
                    @T("Auswahl neu bewerten")
                </MudButton>
                <MudButton Class="btn-quiet" OnClick="() => selected.Clear()">@T("Auswahl aufheben ({0})", selected.Count)</MudButton>
            }
            <span class="topbar-spacer"></span>
            <span class="muted" style="font-size:.9rem">
                @T("{0} von {1} abgeschlossen", Exam.Submissions.Count(s => s.Status == SubmissionStatus.Abgeschlossen), Exam.Submissions.Count)
            </span>
        </div>

        @if (running > 0)
        {
            var total = Exam.Submissions.Count(s => s.Status is SubmissionStatus.InWarteschlange or SubmissionStatus.WirdBewertet or SubmissionStatus.Vorschlag or SubmissionStatus.Abgeschlossen);
            <div class="banner mb-5">
                <MudProgressCircular Indeterminate="true" Size="Size.Small" Style="color:var(--ink)" />
                <span>
                    @(Settings.RunsLocally(Exam)
                        ? T("Noch {0} Arbeit(en) in Bearbeitung · lokal etwa 1–3 Minuten pro Arbeit, eine nach der anderen – du kannst inzwischen weiterarbeiten.", running)
                        : T("Noch {0} Arbeit(en) in Bearbeitung · etwa 30–60 Sekunden pro Arbeit – du kannst inzwischen weiterarbeiten.", running))
                </span>
                <div class="brush-progress"><span style="@($"width:{(total == 0 ? 0 : 100 * (total - running) / total)}%")"></span></div>
            </div>
        }

        <div class="@($"wall {(selected.Count > 0 ? "selecting" : "")}")">
            @foreach (var submission in Exam.Submissions)
            {
                var isSelected = selected.Contains(submission.Id);
                var busy = submission.Status is SubmissionStatus.InWarteschlange or SubmissionStatus.WirdBewertet;
                <div class="@($"work {(isSelected ? "selected" : "")}")" @key="submission.Id">
                    <button type="button" class="work-select" aria-pressed="@(isSelected ? "true" : "false")" aria-label="@T("Auswählen")" @onclick="() => Toggle(submission.Id)">
                        @if (isSelected)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                        }
                    </button>
                    <a class="work-photo" href="@ReviewUrl(submission)">
                        <WorkPhoto Submission="submission" />
                        <GradeStamp Exam="Exam" Submission="submission" />
                    </a>
                    <WorkName Submission="submission" Renamed="OnRenamed" />
                    <div class="work-foot">
                        <span class="@($"status s-{submission.Status}")"><span class="dot"></span>@LevelText.Label(submission.Status)</span>
                        <MudTooltip Text="@(submission.GradedAt is null ? T("Von der KI bewerten lassen") : T("Neu bewerten"))">
                            <MudIconButton Icon="@Icons.Material.Outlined.AutoAwesome" Size="Size.Small"
                                           Disabled="@(!CanGrade || busy)" OnClick="() => GradeAsync([submission])" aria-label="@T("Bewerten")" />
                        </MudTooltip>
                    </div>
                    @if (submission.Status == SubmissionStatus.Fehler && !string.IsNullOrWhiteSpace(submission.ErrorMessage))
                    {
                        <div class="work-error">@submission.ErrorMessage</div>
                    }
                </div>
            }
        </div>
    }

    <div class="next-step">
        @if (NextToReview() is { } open)
        {
            <span class="muted">@T("Prüfe jede Arbeit und schliesse sie ab.")</span>
            <MudButton Class="btn-ink" Size="Size.Large" Href="@ReviewUrl(open)" EndIcon="@Icons.Material.Filled.ArrowForward">@T("Arbeiten prüfen")</MudButton>
        }
        else
        {
            @if (Exam.Submissions.Any(s => s.Status != SubmissionStatus.Abgeschlossen))
            {
                <span class="muted">@T("Lass die Arbeiten zuerst von der KI bewerten.")</span>
            }
            <MudButton Class="btn-ink" Size="Size.Large" Disabled="@(Exam.Submissions.Count == 0)" OnClick="() => Next.InvokeAsync()" EndIcon="@Icons.Material.Filled.ArrowForward">
                @T("Weiter zu den Noten")
            </MudButton>
        }
    </div>
}

@code {
    private const long MaxImageBytes = 40 * 1024 * 1024;
    private const int MaxFiles = 200;
    private static readonly string accept = string.Join(",", ImagePreprocessor.AcceptedExtensions) + ",.heic,.heif";

    [Parameter, EditorRequired] public Exam Exam { get; set; } = null!;
    [Parameter] public EventCallback Changed { get; set; }
    /// <summary>False: step 2, capture the works. True: step 3, let the AI assess them.</summary>
    [Parameter] public bool Grading { get; set; }
    [Parameter] public EventCallback<int> ShowStep { get; set; }
    [Parameter] public EventCallback Next { get; set; }

    private readonly HashSet<Guid> selected = [];
    private bool oneSubmission;
    private bool uploading;
    private int uploadDone;
    private int uploadTotal;
    private List<Submission> ungraded = [];
    private int running;

    private bool CanGrade => Settings.CanGrade(Exam) && Exam.Categories.SelectMany(c => c.Criteria).Any(k => k.AssessedBy == AssessedBy.Ai);

    protected override void OnParametersSet()
    {
        ungraded = Exam.Submissions.Where(s => s.Status is SubmissionStatus.Neu or SubmissionStatus.Fehler && s.Images.Count > 0).ToList();
        running = Exam.Submissions.Count(s => s.Status is SubmissionStatus.InWarteschlange or SubmissionStatus.WirdBewertet);
        selected.IntersectWith(Exam.Submissions.Select(s => s.Id));
    }

    /// <summary>The first work that has a suggestion and still waits for the teacher.</summary>
    private Submission? NextToReview() =>
        Exam.Submissions.FirstOrDefault(s => s.Status is SubmissionStatus.Vorschlag);

    private string ReviewUrl(Submission submission) => $"/pruefung/{Exam.Id}/arbeit/{submission.Id}";

    private string EditUrl(Submission submission) => $"/pruefung/{Exam.Id}/arbeit/{submission.Id}/bearbeiten";

    private void Toggle(Guid id)
    {
        if (!selected.Remove(id))
        {
            selected.Add(id);
        }
    }

    private async Task UploadAsync(InputFileChangeEventArgs e)
    {
        var files = e.GetMultipleFiles(MaxFiles);
        uploading = true;
        uploadDone = 0;
        uploadTotal = files.Count;
        var errors = new List<string>();
        var stored = new List<SubmissionImage>();

        foreach (var file in files)
        {
            try
            {
                if (file.Size > MaxImageBytes)
                {
                    throw new UnsupportedImageException(T("grösser als 40 MB"));
                }
                await using var stream = file.OpenReadStream(MaxImageBytes);
                var path = await Files.SaveSubmissionImageAsync(Exam.Id, stream, CancellationToken.None);
                stored.Add(new SubmissionImage { OriginalName = "", RelativePath = path });
            }
            catch (UnsupportedImageException ex)
            {
                errors.Add($"{file.Name}: {ex.Message}");
            }
            uploadDone++;
            StateHasChanged();
        }

        if (stored.Count > 0)
        {
            if (oneSubmission)
            {
                await Repository.AddSubmissionAsync(Exam.Id, null, stored);
            }
            else
            {
                foreach (var image in stored)
                {
                    await Repository.AddSubmissionAsync(Exam.Id, null, [image]);
                }
            }
        }

        uploading = false;
        foreach (var error in errors)
        {
            Snackbar.Add(error, Severity.Error, o => o.RequireInteraction = true);
        }
        if (stored.Count > 0)
        {
            Snackbar.Add(T("{0} Foto(s) hinzugefügt. Die Arbeiten haben Zufallsnamen – echte Namen direkt unter den Bildern eintragen.", stored.Count), Severity.Success);
        }
        await Changed.InvokeAsync();
    }

    private Task OnRenamed((Submission Submission, string Name) change) => RenameAsync(change.Submission, change.Name);

    private async Task RenameAsync(Submission submission, string name)
    {
        (submission.StudentName, submission.HasPlaceholderName) = await Repository.RenameSubmissionAsync(submission.Id, name);
    }

    private async Task GradeAsync(IReadOnlyList<Submission> submissions)
    {
        var finished = submissions.Count(s => s.Status == SubmissionStatus.Abgeschlossen);
        if (finished > 0)
        {
            var confirmed = await Dialogs.ShowMessageBoxAsync(
                T("Abgeschlossene Arbeiten neu bewerten?"),
                T("{0} der gewählten Arbeiten sind abgeschlossen. Die KI-Vorschläge werden ersetzt, deine eigenen Einstufungen bleiben erhalten.", finished),
                yesText: T("Neu bewerten"),
                cancelText: T("Abbrechen"));
            if (confirmed != true)
            {
                return;
            }
        }
        var ids = submissions.Where(s => s.Images.Count > 0).Select(s => s.Id).ToList();
        await Queue.EnqueueAsync(Exam.Id, ids);
        Snackbar.Add(T("{0} Arbeit(en) in der Warteschlange.", ids.Count), Severity.Info);
        await Changed.InvokeAsync();
    }

    private Task GradeSelectedAsync() =>
        GradeAsync(Exam.Submissions.Where(s => selected.Contains(s.Id) && s.Status is not (SubmissionStatus.InWarteschlange or SubmissionStatus.WirdBewertet)).ToList());

    private async Task MergeAsync()
    {
        var ordered = Exam.Submissions.Where(s => selected.Contains(s.Id)).OrderBy(s => s.CreatedAt).ToList();
        var target = ordered.First();
        var others = ordered.Skip(1).ToList();
        var lost = others.Where(s => !s.HasPlaceholderName || s.Assessments.Any(a => a.TeacherLevel is not null) || !string.IsNullOrWhiteSpace(s.TeacherComment))
            .Select(s => $"«{s.StudentName}»")
            .ToList();
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            T("Zu einer Arbeit zusammenführen?"),
            T("Die Fotos von {0} Karten werden zur Arbeit «{1}» zusammengefasst. Bisherige KI-Vorschläge der anderen Karten gehen verloren.", ordered.Count, target.StudentName)
                + (lost.Count == 0 ? "" : " " + T("Achtung: Bei {0} gehen auch der eingetragene Name, deine Einstufungen und deine Rückmeldung verloren.", string.Join(", ", lost)))
                + " " + T("Einzelne Fotos lassen sich später in der Arbeit wieder abtrennen."),
            yesText: T("Zusammenführen"),
            cancelText: T("Abbrechen"));
        if (confirmed != true)
        {
            return;
        }
        await Repository.MergeSubmissionsAsync(target.Id, ordered.Skip(1).Select(s => s.Id).ToList());
        selected.Clear();
        await Changed.InvokeAsync();
    }

    private async Task DeleteSelectedAsync()
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            T("Arbeiten löschen?"),
            T("{0} Arbeit(en) mit Fotos und Bewertungen werden endgültig gelöscht.", selected.Count),
            yesText: T("Löschen"),
            cancelText: T("Abbrechen"));
        if (confirmed != true)
        {
            return;
        }
        foreach (var id in selected.ToList())
        {
            foreach (var image in await Repository.DeleteSubmissionAsync(id))
            {
                Files.Delete(image.RelativePath);
            }
        }
        selected.Clear();
        await Changed.InvokeAsync();
    }
}
