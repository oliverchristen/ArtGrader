@* The first photo of a work with the photo count, as shown on the work cards. *@
@if (Submission.Images.Count > 0)
{
    <img src="@ImageUrls.Covered(Submission.Images[0])" alt="Foto der Arbeit von @Submission.StudentName" loading="lazy" />
}
else
{
    <div class="placeholder"></div>
}
@if (Submission.Images.Count > 1)
{
    <span class="photo-count">@Submission.Images.Count Fotos</span>
}

@code {
    [Parameter, EditorRequired] public Submission Submission { get; set; } = null!;
}
