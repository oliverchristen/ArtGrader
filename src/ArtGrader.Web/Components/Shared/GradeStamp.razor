@* The round grade stamp on a work card: final grade, provisional grade or nothing. *@
@{
    var result = GradeCalculator.Calculate(Exam, Submission);
    var grade = GradeCalculator.FinalGrade(Exam, Submission);
}
@if (grade is not null)
{
    <span class="@($"stamp {(Submission.Status == SubmissionStatus.Abgeschlossen ? "final" : "")}")" title="@T("{0:0.##} / {1:0.##} points", result.Points, result.MaxPoints)">
        @grade.Value.ToString("0.0#")<small>@T("Grade")</small>
    </span>
}
else if (result.Provisional is not null)
{
    <span class="stamp provisional" title="@T("Provisional – {0} teacher criterion/criteria still open", result.MissingCount)">
        @result.Provisional.Value.ToString("0.0#")<small>@T("provisional")</small>
    </span>
}

@code {
    [Parameter, EditorRequired] public Exam Exam { get; set; } = null!;
    [Parameter, EditorRequired] public Submission Submission { get; set; } = null!;
}
