@using ArtGrader.Core.Images
@inject IJSRuntime JS

<div class="cover-tools">
    @switch (mode)
    {
        case Mode.Cover:
            <span class="cover-hint">Rechteck über die Stelle ziehen, die schwarz werden soll.</span>
            <span class="topbar-spacer"></span>
            <MudButton Class="btn-quiet" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Undo" Disabled="@(Covers.Count == 0)" OnClick="RemoveLastAsync">Letzten Balken entfernen</MudButton>
            <MudButton Class="btn-ink" Size="Size.Small" StartIcon="@Icons.Material.Filled.Check" OnClick="() => mode = Mode.View">Fertig</MudButton>
            break;
        case Mode.Crop:
            <span class="cover-hint">Rechteck um den Bereich ziehen, der bleiben soll.</span>
            <span class="topbar-spacer"></span>
            <MudButton Class="btn-quiet" Size="Size.Small" StartIcon="@Icons.Material.Outlined.CropFree" Disabled="@(Crop is null)" OnClick="RemoveCropAsync">Zuschnitt aufheben</MudButton>
            <MudButton Class="btn-ink" Size="Size.Small" StartIcon="@Icons.Material.Filled.Check" OnClick="() => mode = Mode.View">Fertig</MudButton>
            break;
        default:
            <MudButton Class="btn-soft" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Rectangle" OnClick="() => Start(Mode.Cover)">@CoverLabel</MudButton>
            <MudButton Class="btn-soft" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Crop" OnClick="() => Start(Mode.Crop)">Zuschneiden</MudButton>
            @if (Summary() is { Length: > 0 } summary)
            {
                <span class="cover-hint">@summary</span>
            }
            break;
    }
</div>

<div class="@($"frame {(zoomed && mode == Mode.View ? "zoomed" : "")} {FrameClass}")">
    <div class="@($"cover-box {(mode == Mode.View ? "" : "editing")}")">
        <img src="@Src" alt="@Alt" @onclick="() => zoomed = mode == Mode.View && !zoomed" />
        @foreach (var cover in Covers)
        {
            <span class="cover" style="@Style(cover)"></span>
        }
        @if (Crop is not null && !(mode == Mode.Crop && draft is not null))
        {
            <span class="crop-frame" style="@Style(Crop)"></span>
        }
        @if (draft is not null)
        {
            <span class="@(mode == Mode.Crop ? "crop-frame draft" : "cover draft")" style="@Style(draft)"></span>
        }
        @if (mode != Mode.View)
        {
            <div class="cover-surface" @ref="surface"
                 @onpointerdown="StartDragAsync" @onpointermove="Move" @onpointerup="FinishAsync" @onpointerleave="FinishAsync"></div>
        }
    </div>
</div>

@code {
    private enum Mode { View, Cover, Crop }

    [Parameter, EditorRequired] public string Src { get; set; } = "";
    [Parameter, EditorRequired] public List<CoverArea> Covers { get; set; } = [];
    [Parameter] public CoverArea? Crop { get; set; }
    [Parameter, EditorRequired] public Guid ItemId { get; set; }
    [Parameter] public string Alt { get; set; } = "";
    [Parameter] public string CoverLabel { get; set; } = "Name oder Signatur abdecken";
    [Parameter] public string FrameClass { get; set; } = "";
    [Parameter] public EventCallback<ImageEdits> Save { get; set; }

    private ElementReference surface;
    private Mode mode;
    private bool zoomed;
    private Guid shownItem;
    private (double X, double Y)? start;
    private double width;
    private double height;
    private CoverArea? draft;

    protected override void OnParametersSet()
    {
        if (shownItem != ItemId)
        {
            shownItem = ItemId;
            mode = Mode.View;
            zoomed = false;
            start = null;
            draft = null;
        }
    }

    private string Summary()
    {
        var parts = new List<string>();
        if (Covers.Count > 0)
        {
            parts.Add(Covers.Count == 1 ? "1 Stelle abgedeckt" : $"{Covers.Count} Stellen abgedeckt");
        }
        if (Crop is not null)
        {
            parts.Add("zugeschnitten");
        }
        return parts.Count == 0 ? "" : string.Join(" · ", parts) + " · die KI sieht nur den hellen Bereich ohne Balken";
    }

    private static string Style(CoverArea area) =>
        $"left:{ImageUrls.Percent(area.X)};top:{ImageUrls.Percent(area.Y)};width:{ImageUrls.Percent(area.Width)};height:{ImageUrls.Percent(area.Height)}";

    private void Start(Mode next)
    {
        zoomed = false;
        mode = next;
    }

    private async Task StartDragAsync(PointerEventArgs e)
    {
        var size = await JS.InvokeAsync<double[]>("artGrader.size", surface);
        (width, height) = (size[0], size[1]);
        if (width <= 0 || height <= 0)
        {
            return;
        }
        start = (e.OffsetX / width, e.OffsetY / height);
        draft = null;
    }

    private void Move(PointerEventArgs e)
    {
        if (start is { } from)
        {
            draft = ImageCover.Normalize(from.X, from.Y, e.OffsetX / width, e.OffsetY / height);
        }
    }

    private async Task FinishAsync(PointerEventArgs e)
    {
        if (start is not { } from)
        {
            return;
        }
        var area = ImageCover.Normalize(from.X, from.Y, e.OffsetX / width, e.OffsetY / height);
        start = null;
        draft = null;
        if (mode == Mode.Crop)
        {
            if (area.Width >= 0.05 && area.Height >= 0.05)
            {
                await SaveAsync(Covers, area);
            }
        }
        else if (area.Width >= 0.01 && area.Height >= 0.01)
        {
            await SaveAsync([.. Covers, area], Crop);
        }
    }

    private Task RemoveLastAsync() => SaveAsync(Covers.Take(Covers.Count - 1).ToList(), Crop);

    private Task RemoveCropAsync() => SaveAsync(Covers, null);

    private async Task SaveAsync(List<CoverArea> covers, CoverArea? crop)
    {
        Covers = covers;
        Crop = crop;
        await Save.InvokeAsync(new ImageEdits(covers, crop));
    }
}
