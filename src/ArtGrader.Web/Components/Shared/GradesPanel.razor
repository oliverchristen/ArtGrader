@* Step 4: how levels become grades, and all works with their grade. *@
@inject ExamRepository Repository
@implements IAsyncDisposable

<section class="sheet">
    <h2 class="sheet-title">@T("Grade calculation")</h2>
    <p class="sheet-sub">@T("This is how the levels become a grade. Changes apply straight away to all works below.")</p>
    <div class="points-grid">
        <div class="point-swatch"><span class="sw" style="background:var(--level-3)"></span><MudNumericField @bind-Value="settings.PointsUebertroffen" @bind-Value:after="SettingsChanged" Immediate="true" Error="@(!settings.HasDescendingPoints)" Label="@T("Exceeded")" Variant="Variant.Text" Min="0" Max="10" /></div>
        <div class="point-swatch"><span class="sw" style="background:var(--level-2)"></span><MudNumericField @bind-Value="settings.PointsErfuellt" @bind-Value:after="SettingsChanged" Immediate="true" Error="@(!settings.HasDescendingPoints)" Label="@T("Met")" Variant="Variant.Text" Min="0" Max="10" /></div>
        <div class="point-swatch"><span class="sw" style="background:var(--level-1)"></span><MudNumericField @bind-Value="settings.PointsTeilweise" @bind-Value:after="SettingsChanged" Immediate="true" Error="@(!settings.HasDescendingPoints)" Label="@T("Partly")" Variant="Variant.Text" Min="0" Max="10" /></div>
        <div class="point-swatch"><span class="sw" style="background:var(--level-0)"></span><MudNumericField @bind-Value="settings.PointsNicht" @bind-Value:after="SettingsChanged" Immediate="true" Error="@(!settings.HasDescendingPoints)" Label="@T("Not met")" Variant="Variant.Text" Min="0" Max="10" /></div>
    </div>
    @if (!settings.HasDescendingPoints)
    {
        <div class="banner error mt-3">
            <MudIcon Icon="@Icons.Material.Outlined.ErrorOutline" />
            <span>@T("Points must decrease from left to right: Exceeded more than Met, Met more than Partly met, Partly met more than Not met. Nothing is saved like this; the grades below use the last valid points.")</span>
        </div>
    }
    <MudSelect T="decimal" @bind-Value="settings.RoundingStep" @bind-Value:after="SettingsChanged" Label="@T("Round to")" Variant="Variant.Outlined" Class="mt-4">
        <MudSelectItem T="decimal" Value="0.5m">@T("Half grades (4.5)")</MudSelectItem>
        <MudSelectItem T="decimal" Value="0.25m">@T("Quarter grades (4.25)")</MudSelectItem>
        <MudSelectItem T="decimal" Value="0.1m">@T("Tenths (4.3)")</MudSelectItem>
    </MudSelect>
    <div class="formula">@T("Grade = points ÷ maximum × 5 + 1") &nbsp;·&nbsp; <span class="muted" style="font-style:normal">@Example()</span></div>
</section>

@if (Exam.Submissions.Count == 0)
{
    <div class="banner mt-5">
        <MudIcon Icon="@Icons.Material.Outlined.Info" />
        <span>@T("No works yet.") <a href="javascript:void(0)" @onclick="() => ShowStep.InvokeAsync(1)">@T("Go to step 2")</a></span>
    </div>
}
else
{
    <div class="toolbar mt-6">
        <h2 class="sheet-title" style="margin:0">@T("All works")</h2>
        <span class="topbar-spacer"></span>
        <span class="muted" style="font-size:.9rem">
            @T("{0} of {1} completed", Exam.Submissions.Count(s => s.Status == SubmissionStatus.Abgeschlossen), Exam.Submissions.Count)
        </span>
    </div>
    <div class="wall">
        @foreach (var submission in Exam.Submissions)
        {
            <div class="work" @key="submission.Id">
                <a class="work-photo" href="@($"/pruefung/{Exam.Id}/arbeit/{submission.Id}")">
                    <WorkPhoto Submission="submission" />
                    <GradeStamp Exam="shown" Submission="submission" />
                </a>
                <div class="@($"work-name {(submission.HasPlaceholderName ? "placeholder-name" : "")}")">
                    <div class="work-name-text">@submission.StudentName</div>
                    @if (submission.HasPlaceholderName)
                    {
                        <span class="name-hint">@T("random name")</span>
                    }
                </div>
                <div class="work-foot">
                    <span class="@($"status s-{submission.Status}")"><span class="dot"></span>@LevelText.Label(submission.Status)</span>
                </div>
            </div>
        }
    </div>
}

<div class="next-step">
    @if (Exam.Submissions.Any(s => s.Status != SubmissionStatus.Abgeschlossen))
    {
        <span class="muted">@T("Not all works are completed yet. Click a picture to open the work.")</span>
    }
    <MudButton Class="btn-ink" Size="Size.Large" Disabled="@(Exam.Submissions.Count == 0)" OnClick="GoNextAsync" EndIcon="@Icons.Material.Filled.ArrowForward">
        @T("Continue to Overview & export")
    </MudButton>
</div>

@code {
    [Parameter, EditorRequired] public Exam Exam { get; set; } = null!;
    [Parameter] public EventCallback Changed { get; set; }
    [Parameter] public EventCallback<int> ShowStep { get; set; }
    [Parameter] public EventCallback Next { get; set; }

    private readonly Debouncer saver = new();
    private GradingSettings settings = new();

    /// <summary>The last points in a valid order; saved and used for the grades while the input is not valid.</summary>
    private GradingSettings lastValid = new();
    private Guid loadedFor;

    /// <summary>The exam with the settings as currently edited, so the grades follow each change at once.</summary>
    private Exam shown = new();

    protected override void OnParametersSet()
    {
        if (loadedFor != Exam.Id)
        {
            loadedFor = Exam.Id;
            settings = Copy(Exam.Settings);
            lastValid = Copy(Exam.Settings);
        }
        shown = new Exam
        {
            Id = Exam.Id,
            Settings = settings.HasDescendingPoints ? settings : lastValid,
            Categories = Exam.Categories,
            Submissions = Exam.Submissions,
        };
    }

    private static GradingSettings Copy(GradingSettings source) => new()
    {
        PointsUebertroffen = source.PointsUebertroffen,
        PointsErfuellt = source.PointsErfuellt,
        PointsTeilweise = source.PointsTeilweise,
        PointsNicht = source.PointsNicht,
        RoundingStep = source.RoundingStep,
        MinGrade = source.MinGrade,
        MaxGrade = source.MaxGrade,
    };

    private string Example()
    {
        var count = Math.Max(1, Exam.Categories.Sum(c => c.Criteria.Count(k => k.Weight > 0)));
        var used = settings.HasDescendingPoints ? settings : lastValid;
        var max = count * used.MaxLevelPoints;
        if (max == 0)
        {
            return "";
        }
        var points = count * used.PointsErfuellt;
        var grade = GradeCalculator.ToGrade(points, max, used);
        return T("everything ‘met’ = {0}/{1} points → {2:0.0#}", points, max, grade);
    }

    private void SettingsChanged()
    {
        // Typing «10» passes «1» first: an invalid order is shown but not saved until it is valid again.
        if (!settings.HasDescendingPoints)
        {
            return;
        }
        lastValid = Copy(settings);
        saver.Schedule(() => InvokeAsync(SaveAsync));
    }

    private async Task SaveAsync()
    {
        await Repository.UpdateGradingSettingsAsync(Exam.Id, lastValid);
        await Changed.InvokeAsync();
    }

    private async Task GoNextAsync()
    {
        await saver.FlushAsync();
        await Next.InvokeAsync();
    }

    public ValueTask DisposeAsync() => saver.DisposeAsync();
}
