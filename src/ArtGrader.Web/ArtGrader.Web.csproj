<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <AssemblyName>ArtGrader</AssemblyName>
    <RootNamespace>ArtGrader.Web</RootNamespace>
    <Version>0.4.0</Version>
  </PropertyGroup>

  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('win'))">
    <OutputType>WinExe</OutputType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
  </PropertyGroup>

  <Target Name="RemovePublishedSymbols" AfterTargets="Publish">
    <ItemGroup>
      <PublishedSymbols Include="$(PublishDir)*.pdb;$(PublishDir)appsettings.Development.json" />
    </ItemGroup>
    <Delete Files="@(PublishedSymbols)" />
  </Target>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0" />
    <PackageReference Include="MudBlazor" Version="9.14.0" />
    <PackageReference Include="QuestPDF" Version="2026.9.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ArtGrader.Core\ArtGrader.Core.csproj" />
  </ItemGroup>

  <!-- The overview for school management lives in docs/ and is built into the app, which serves it as
       /schulleitung.html (see Program.cs). A linked wwwroot file came out empty when running from the IDE. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\docs\schulleitung.html" LogicalName="schulleitung.html" />
  </ItemGroup>

</Project>
