<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="13.14.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
    <PackageReference Include="SkiaSharp" Version="4.158.0" />
  </ItemGroup>

  <!-- Translations (de, fr, it, rm), one JSON file per area; keys are the English texts used in the code. -->
  <ItemGroup>
    <EmbeddedResource Include="Localization\*\*.json" />
  </ItemGroup>

</Project>
