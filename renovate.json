{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard", ":semanticCommitsDisabled"],
  "timezone": "Europe/Zurich",
  "schedule": ["before 6am on monday"],
  "labels": ["dependencies"],
  "dependencyDashboardApproval": false,
  "separateMajorMinor": false,
  "packageRules": [
    {
      "description": "All updates, major ones included, in a single pull request.",
      "matchPackageNames": ["*"],
      "groupName": "all dependencies",
      "groupSlug": "all"
    },
    {
      "description": "SDK in global.json: only follow updates of the same major version (net11).",
      "matchManagers": ["nuget"],
      "matchDepNames": ["dotnet-sdk"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
